<article class="wrap article-page">
  <nav class="crumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <a href="{{ blog.url }}">{{ blog.title }}</a>
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current" aria-current="page">{{ article.title }}</span>
  </nav>

  <header class="article-page__head">
    <div class="article-page__meta">
      <span>{{ article.published_at | date: '%B %-d, %Y' }}</span>
      <span class="article-page__dot" aria-hidden="true">&middot;</span>
      <span>{{ 'blog.written_by' | t: author: article.author }}</span>
    </div>
    <h1 class="article-page__title">{{ article.title }}</h1>
  </header>

  {% if article.image %}
    <div class="article-page__hero">
      {{
        article.image
        | image_url: width: 1800
        | image_tag: class: 'article-page__img', widths: '800, 1200, 1800', sizes: '(max-width: 1024px) 100vw, 920px', alt: article.image.alt
      }}
    </div>
  {% endif %}

  <div class="article-page__content rte">
    {{ article.content }}
  </div>

  <div class="article-page__foot">
    <a href="{{ blog.url }}" class="more">&larr; {{ 'blog.back_to' | t: blog: blog.title }}</a>
  </div>

  {% if blog.comments_enabled? %}
    <section class="comments" id="comments">
      <h2 class="comments__title">
        {{ 'blog.comments_title' | t: count: article.comments_count }}
      </h2>

      {% paginate article.comments by 10 %}
        {% if article.comments_count > 0 %}
          <ul class="comments__list" role="list">
            {% for comment in article.comments %}
              <li class="comment">
                <div class="comment__meta">
                  <span class="comment__author">{{ comment.author }}</span>
                  <span class="comment__date">{{ comment.created_at | date: '%B %-d, %Y' }}</span>
                </div>
                <div class="comment__body rte">{{ comment.content }}</div>
              </li>
            {% endfor %}
          </ul>

          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">
              {% if paginate.previous %}
                <a href="{{ paginate.previous.url }}" class="pagination__arrow">&larr;</a>
              {% endif %}
              {% for part in paginate.parts %}
                {% if part.is_link %}
                  <a href="{{ part.url }}" class="pagination__page">{{ part.title }}</a>
                {% elsif part.title == paginate.current_page %}
                  <span class="pagination__page is-current" aria-current="page">{{ part.title }}</span>
                {% else %}
                  <span class="pagination__gap">{{ part.title }}</span>
                {% endif %}
              {% endfor %}
              {% if paginate.next %}
                <a href="{{ paginate.next.url }}" class="pagination__arrow">&rarr;</a>
              {% endif %}
            </nav>
          {% endif %}
        {% endif %}
      {% endpaginate %}

      {% form 'new_comment', article, class: 'comments__form' %}
        <h3 class="comments__form-title">{{ 'blog.comment_form_title' | t }}</h3>

        {% if form.posted_successfully? %}
          <p class="comments__success">
            {% if blog.moderated? %}
              {{ 'blog.comment_moderated' | t }}
            {% else %}
              {{ 'blog.comment_posted' | t }}
            {% endif %}
          </p>
        {% endif %}
        {% if form.errors %}
          <div class="comments__errors" role="alert">
            <p>{{ 'contact.error' | t }}</p>
            <ul>
              {% for field in form.errors %}
                <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
              {% endfor %}
            </ul>
          </div>
        {% endif %}

        <div class="comments__row">
          <div class="comments__field">
            <label for="comment-author">{{ 'blog.comment_form_name' | t }}</label>
            <input id="comment-author" type="text" name="comment[author]" value="{{ form.author }}" autocomplete="name" required>
          </div>
          <div class="comments__field">
            <label for="comment-email">{{ 'blog.comment_form_email' | t }}</label>
            <input id="comment-email" type="email" name="comment[email]" value="{{ form.email }}" autocomplete="email" required>
          </div>
        </div>
        <div class="comments__field">
          <label for="comment-body">{{ 'blog.comment_form_body' | t }}</label>
          <textarea id="comment-body" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn btn--dark">{{ 'blog.comment_form_submit' | t }}</button>
      {% endform %}
    </section>
  {% endif %}
</article>

{% stylesheet %}
  .article-page {
    padding-bottom: 80px;
  }

  .article-page__head {
    max-width: 720px;
    margin: 30px auto 30px;
    text-align: center;
  }

  .article-page__meta {
    display: flex;
    justify-content: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 14px;
  }

  .article-page__dot {
    opacity: 0.5;
  }

  .article-page__title {
    margin: 0;
    font-size: 44px;
    letter-spacing: -0.035em;
    font-weight: 600;
    line-height: 1.05;
    text-wrap: balance;
  }

  .article-page__hero {
    max-width: 920px;
    margin: 0 auto 40px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background-secondary);
  }

  .article-page__img {
    width: 100%;
    height: auto;
  }

  .article-page__content {
    max-width: 720px;
    margin: 0 auto;
    font-size: 16px;
    line-height: 1.75;
    color: var(--color-muted);
  }

  .article-page__content h2,
  .article-page__content h3 {
    color: var(--color-foreground);
  }

  .article-page__content img {
    border-radius: 4px;
  }

  .article-page__foot {
    max-width: 720px;
    margin: 40px auto 0;
  }

  .comments {
    max-width: 720px;
    margin: 64px auto 0;
    border-top: 1px solid var(--color-line);
    padding-top: 40px;
  }

  .comments__title {
    margin: 0 0 24px;
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .comments__list {
    margin: 0 0 36px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .comment {
    background: var(--color-background-secondary);
    border-radius: 4px;
    padding: 20px 22px;
  }

  .comment__meta {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin-bottom: 8px;
  }

  .comment__author {
    font-size: 14px;
    font-weight: 600;
  }

  .comment__date {
    font-size: 12px;
    color: var(--color-muted);
  }

  .comment__body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .comments__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .comments__form-title {
    margin: 0;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .comments__success {
    margin: 0;
    padding: 14px 16px;
    background: var(--color-background-secondary);
    border-radius: var(--style-border-radius-inputs);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .comments__errors {
    padding: 14px 16px;
    border: 1px solid var(--color-accent-secondary);
    border-radius: var(--style-border-radius-inputs);
    font-size: 14px;
  }

  .comments__errors p {
    margin: 0 0 6px;
    font-weight: 600;
  }

  .comments__errors ul {
    margin: 0;
    padding-left: 18px;
  }

  .comments__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .comments__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .comments__field label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .comments__field input,
  .comments__field textarea {
    border: 1px solid var(--color-input-line);
    background: var(--color-background);
    border-radius: var(--style-border-radius-inputs);
    padding: 13px 15px;
    font-family: var(--font-primary--family);
    font-size: 15px;
    color: var(--color-foreground);
    outline: none;
  }

  .comments__field input:focus,
  .comments__field textarea:focus {
    border-color: var(--color-accent-secondary);
  }

  .comments__form .btn {
    align-self: flex-start;
  }

  @media (max-width: 700px) {
    .article-page__title {
      font-size: 32px;
    }

    .comments__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
