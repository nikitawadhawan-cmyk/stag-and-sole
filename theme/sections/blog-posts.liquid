<section class="wrap blog-posts" data-reveal>
  <header class="blog-posts__head">
    <div>
      {% if section.settings.eyebrow != blank %}
        <span class="blog-posts__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="blog-posts__title">{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.blog != blank %}
      <a href="{{ section.settings.blog.url }}" class="more">{{ 'sections.blog_posts.view_all' | t }} &rarr;</a>
    {% endif %}
  </header>

  <div class="blog-posts__grid" data-reveal-stagger>
    {% liquid
      assign posts_limit = section.settings.posts_to_show
      assign blog = section.settings.blog
    %}
    {% if blog != blank and blog.articles_count > 0 %}
      {% for article in blog.articles limit: posts_limit %}
        <article class="bpost">
          <a href="{{ article.url }}" class="bpost__media" tabindex="-1" aria-hidden="true">
            {% if article.image %}
              {%- liquid
                assign focal_style = nil
                if article.image.presentation.focal_point
                  assign focal_style = 'object-position: ' | append: article.image.presentation.focal_point
                endif
              -%}
              {{
                article.image
                | image_url: width: 900
                | image_tag: class: 'bpost__img', widths: '450, 700, 900', sizes: '(max-width: 900px) 100vw, 33vw', loading: 'lazy', alt: article.image.alt, style: focal_style
              }}
            {% else %}
              {% render 'placeholder-image', name: 'cafe', class: 'bpost__img', sizes: '(max-width: 900px) 100vw, 33vw' %}
            {% endif %}
          </a>
          <div class="bpost__body">
            {% if section.settings.show_date %}
              <span class="bpost__meta">{{ article.published_at | date: format: 'month_day_year' }}</span>
            {% endif %}
            <h3 class="bpost__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
            {% if section.settings.show_excerpt and article.excerpt_or_content != blank %}
              <p class="bpost__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    {% else %}
      {% assign placeholder_names = 'cafe|bench|unboxing' | split: '|' %}
      {% for i in (1..3) limit: posts_limit %}
        <article class="bpost">
          <div class="bpost__media" aria-hidden="true">
            {% render 'placeholder-image', name: placeholder_names[forloop.index0], class: 'bpost__img', sizes: '(max-width: 900px) 100vw, 33vw' %}
          </div>
          <div class="bpost__body">
            {% if section.settings.show_date %}
              <span class="bpost__meta">{{ 'now' | date: format: 'month_day_year' }}</span>
            {% endif %}
            <h3 class="bpost__title">{{ 'sections.blog_posts.placeholder_title' | t }}</h3>
            {% if section.settings.show_excerpt %}
              <p class="bpost__excerpt">{{ 'sections.blog_posts.placeholder_excerpt' | t }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .blog-posts {
    padding-top: 64px;
    padding-bottom: 24px;
  }

  .blog-posts__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }

  .blog-posts__eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 8px;
  }

  .blog-posts__title {
    margin: 0;
    font-size: 32px;
    letter-spacing: -0.03em;
    font-weight: 600;
  }

  .blog-posts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .bpost__media {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    background: var(--color-background-secondary);
  }

  .bpost__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .bpost:hover .bpost__img {
    transform: scale(1.04);
  }

  .bpost__body {
    padding-top: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bpost__meta {
    font-size: 12px;
    color: var(--color-muted);
  }

  .bpost__title {
    margin: 0;
    font-size: 18px;
    letter-spacing: -0.01em;
    font-weight: 600;
    line-height: 1.35;
  }

  .bpost__title a {
    color: var(--color-foreground);
  }

  .bpost__title a:hover {
    color: var(--color-accent-secondary);
  }

  .bpost__excerpt {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (max-width: 900px) {
    .blog-posts__grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .blog-posts__title {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bpost__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories from the workshop"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Posts to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
