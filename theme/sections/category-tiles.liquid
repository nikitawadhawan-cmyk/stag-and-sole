<section class="wrap section">
  <div class="section-head">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.link_label != blank %}
      <a href="{{ section.settings.link | default: routes.collections_url }}" class="more">
        {{- section.settings.link_label }} &rarr;</a>
    {% endif %}
  </div>

  <div class="cats">
    {% for block in section.blocks %}
      {% liquid
        assign collection = block.settings.collection
        assign tile_image = block.settings.image | default: collection.featured_image | default: collection.products.first.featured_image
        assign tile_title = block.settings.heading | default: collection.title
      %}
      <a
        href="{{ collection.url | default: routes.collections_url }}"
        class="cat{% if forloop.first and section.settings.first_tile_wide %} cat--wide{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if tile_image %}
          {{
            tile_image
            | image_url: width: 1200
            | image_tag: class: 'cat__img', widths: '600, 900, 1200', sizes: '(max-width: 1024px) 100vw, 40vw', loading: 'lazy'
          }}
        {% else %}
          {% assign placeholder_index = forloop.index0 | modulo: 3 | plus: 1 %}
          <img
            src="{{ 'placeholder-cat-' | append: placeholder_index | append: '.jpg' | asset_url }}"
            class="cat__img"
            alt=""
            width="900"
            height="1100"
            loading="lazy"
          >
        {% endif %}
        <div class="cat__overlay{% if forloop.first and section.settings.first_tile_wide %} cat__overlay--row{% endif %}">
          <span class="cat__name">{{ tile_title }}</span>
          {% if collection != blank and section.settings.show_product_count %}
            <span class="cat__count">
              {{- 'sections.category_tiles.styles_count' | t: count: collection.products_count -}}
            </span>
          {% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .cats {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 16px;
  }

  .cat {
    position: relative;
    display: block;
    height: 440px;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background-secondary);
  }

  .cat__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cat__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 26px;
    background: linear-gradient(transparent, rgba(var(--color-foreground-rgb), 0.6));
    pointer-events: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cat__overlay--row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
  }

  .cat__name {
    font-size: 25px;
    font-weight: 600;
    color: var(--color-background);
    letter-spacing: -0.02em;
  }

  .cat__count {
    font-size: 13px;
    color: var(--color-background);
    opacity: 0.8;
  }

  @media (max-width: 1024px) {
    .cats {
      grid-template-columns: 1fr 1fr;
    }

    .cat--wide {
      grid-column: 1 / -1;
    }

    .cat {
      height: 360px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All shoes"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "first_tile_wide",
      "label": "Make first tile wide",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Overrides the collection title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Overrides the collection image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category tiles",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
