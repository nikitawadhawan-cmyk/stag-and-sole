{% liquid
  assign per_page = section.settings.products_per_page
%}

{% paginate collection.products by per_page %}
  <section class="wrap collection-page">
    {% if section.settings.show_breadcrumbs %}
      <nav class="crumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
        <span class="crumbs__sep" aria-hidden="true">/</span>
        <span class="crumbs__current" aria-current="page">{{ collection.title }}</span>
      </nav>
    {% endif %}

    <header class="collection-head">
      <div class="collection-head__stack">
        <h1 class="collection-head__title">
          {{ collection.title }}
        </h1>
        {% if section.settings.show_description and collection.description != blank %}
          <div class="collection-head__description rte">{{ collection.description }}</div>
        {% endif %}
      </div>
      <span class="collection-head__count">
        {{- 'sections.category_tiles.styles_count' | t: count: collection.products_count -}}
      </span>
    </header>

    <collection-filters class="collection-toolbar">
      <form method="get" action="{{ collection.url }}" data-filter-form>
        <div class="collection-toolbar__row">
          {% if section.settings.enable_filtering and collection.filters.size > 0 %}
            <div class="collection-toolbar__filters">
              {% for filter in collection.filters %}
                <details class="cfilter" data-filter-details>
                  <summary class="cfilter__summary">
                    {{ filter.label }}
                    {%- if filter.active_values.size > 0 -%}
                      <span class="cfilter__count">{{ filter.active_values.size }}</span>
                    {%- endif %}
                    <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                      <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"/>
                    </svg>
                  </summary>
                  <div class="cfilter__panel">
                    {% case filter.type %}
                      {% when 'list', 'boolean' %}
                        <ul class="cfilter__list" role="list">
                          {% for value in filter.values %}
                            <li>
                              <label class="cfilter__option{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                                <input
                                  type="checkbox"
                                  name="{{ value.param_name }}"
                                  value="{{ value.value }}"
                                  {% if value.active %}
                                    checked
                                  {% endif %}
                                  {% if value.count == 0 and value.active == false %}
                                    disabled
                                  {% endif %}
                                >
                                <span class="cfilter__box" aria-hidden="true"></span>
                                <span>{{ value.label }}</span>
                                <span class="cfilter__value-count">{{ value.count }}</span>
                              </label>
                            </li>
                          {% endfor %}
                        </ul>
                      {% when 'price_range' %}
                        {% liquid
                          assign max_placeholder = filter.range_max | money_without_currency | replace: ',', ''
                        %}
                        <div class="cfilter__price">
                          <label>
                            <span>{{ 'collections.from' | t }}</span>
                            <input
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              {% if filter.min_value.value %}
                                value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              {% endif %}
                              min="0"
                              placeholder="0"
                            >
                          </label>
                          <span class="cfilter__price-dash" aria-hidden="true">&ndash;</span>
                          <label>
                            <span>{{ 'collections.to' | t }}</span>
                            <input
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              {% if filter.max_value.value %}
                                value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              {% endif %}
                              min="0"
                              placeholder="{{ max_placeholder }}"
                            >
                          </label>
                        </div>
                    {% endcase %}
                    <noscript>
                      <button type="submit" class="cfilter__apply">{{ 'collections.apply' | t }}</button>
                    </noscript>
                  </div>
                </details>
              {% endfor %}
            </div>
          {% endif %}

          {% if section.settings.enable_sorting %}
            <label class="collection-toolbar__sort">
              <span>{{ 'collections.sort_by' | t }}</span>
              <select name="sort_by" data-sort-select>
                {% for option in collection.sort_options %}
                  <option
                    value="{{ option.value }}"
                    {% if option.value == collection.sort_by %}
                      selected
                    {% endif %}
                  >
                    {{ option.name }}
                  </option>
                {% endfor %}
              </select>
            </label>
          {% endif %}
        </div>

        {% liquid
          assign has_active = false
          for filter in collection.filters
            if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
              assign has_active = true
            endif
          endfor
        %}
        {% if has_active %}
          <div class="collection-toolbar__active">
            {% for filter in collection.filters %}
              {% for value in filter.active_values %}
                <a class="active-pill" href="{{ value.url_to_remove }}">
                  {{ value.label }}
                  <span aria-hidden="true">&times;</span>
                </a>
              {% endfor %}
              {% if filter.type == 'price_range' %}
                {% if filter.min_value.value != blank or filter.max_value.value != blank %}
                  <a class="active-pill" href="{{ filter.url_to_remove }}">
                    {{ filter.min_value.value | default: 0 | money }} &ndash; {{ filter.max_value.value | default: filter.range_max | money }}
                    <span aria-hidden="true">&times;</span>
                  </a>
                {% endif %}
              {% endif %}
            {% endfor %}
            <a class="collection-toolbar__clear" href="{{ collection.url }}">{{ 'collections.clear_all' | t }}</a>
          </div>
        {% endif %}
      </form>
    </collection-filters>

    {% if collection.products.size > 0 %}
      <div class="collection-grid">
        {% for product in collection.products %}
          {% liquid
            assign card_loading = 'lazy'
            if forloop.index <= 2 and paginate.current_page == 1
              assign card_loading = 'eager'
            endif
          %}
          {% render 'product-card', product: product, show_type: true, show_swatches: true, loading: card_loading, show_quick_add: section.settings.show_quick_add %}
        {% endfor %}
      </div>
    {% else %}
      <div class="collection-empty">
        <p>{{ 'collections.empty' | t }}</p>
        <a href="{{ collection.url }}" class="btn btn--outline">{{ 'collections.clear_all' | t }}</a>
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="pagination__arrow">&larr;</a>
        {% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" class="pagination__page">{{ part.title }}</a>
          {% elsif part.title == paginate.current_page %}
            <span class="pagination__page is-current" aria-current="page">{{ part.title }}</span>
          {% else %}
            <span class="pagination__gap">{{ part.title }}</span>
          {% endif %}
        {% endfor %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="pagination__arrow">&rarr;</a>
        {% endif %}
      </nav>
    {% endif %}
  </section>
{% endpaginate %}

{% stylesheet %}
  .collection-page {
    padding-bottom: 40px;
  }
  .collection-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 26px 0 26px;
  }
  .collection-head__title {
    margin: 0;
    font-size: 46px;
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .collection-head__description {
    margin-top: 12px;
    max-width: 520px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted);
  }
  .collection-head__count {
    font-size: 14px;
    color: var(--color-muted);
    white-space: nowrap;
  }
  .collection-empty {
    padding: 80px 0;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .collection-empty p {
    margin: 0;
    font-size: 16px;
    color: var(--color-muted);
  }
  @media (max-width: 700px) {
    .collection-head__title {
      font-size: 32px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class CollectionFilters extends HTMLElement {
    connectedCallback() {
      this.form = this.querySelector('[data-filter-form]');
      if (!this.form) return;

      this.form.addEventListener('change', (event) => {
        if (event.target.matches('input[type="number"]')) return;
        this.form.requestSubmit();
      });

      this.querySelectorAll('input[type="number"]').forEach((input) => {
        input.addEventListener('keydown', (event) => {
          if (event.key === 'Enter') {
            event.preventDefault();
            this.form.requestSubmit();
          }
        });
        input.addEventListener('blur', () => {
          if (input.value !== input.defaultValue) this.form.requestSubmit();
        });
      });

      document.addEventListener('click', (event) => {
        this.querySelectorAll('[data-filter-details][open]').forEach((details) => {
          if (!details.contains(event.target)) details.open = false;
        });
      });

      this.querySelectorAll('[data-filter-details]').forEach((details) => {
        details.addEventListener('toggle', () => {
          if (!details.open) return;
          this.querySelectorAll('[data-filter-details][open]').forEach((other) => {
            if (other !== details) other.open = false;
          });
        });
      });
    }
  }

  customElements.define('collection-filters', CollectionFilters);
{% endjavascript %}

{% schema %}
{
  "name": "Collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add on product cards",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "Configure filters in the Search & Discovery app",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
