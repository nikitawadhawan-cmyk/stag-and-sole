{%- liquid
  assign has_details = false
  if section.settings.email != blank or section.settings.phone != blank or section.settings.address != blank or section.settings.hours != blank
    assign has_details = true
  endif
-%}

<section class="wrap contact">
  <div class="contact__inner{% if has_details %} contact__inner--split{% endif %}">
    <div class="contact__main">
    <h1 class="contact__title">{{ page.title | default: section.settings.heading }}</h1>
    {% if page.content != blank %}
      <div class="contact__intro rte">{{ page.content }}</div>
    {% endif %}

    {% form 'contact', class: 'contact__form' %}
      {% if form.posted_successfully? %}
        <p class="contact__success" tabindex="-1" autofocus>{{ 'contact.success' | t }}</p>
      {% endif %}
      {% if form.errors %}
        <div class="contact__errors" role="alert">
          <p>{{ 'contact.error' | t }}</p>
          <ul>
            {% for field in form.errors %}
              <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <div class="contact__row">
        <div class="contact__field">
          <label for="contact-name">{{ 'contact.name' | t }}</label>
          <input
            id="contact-name"
            type="text"
            name="contact[name]"
            value="{{ form.name }}"
            autocomplete="name"
            required
          >
        </div>
        <div class="contact__field">
          <label for="contact-email">{{ 'contact.email' | t }}</label>
          <input
            id="contact-email"
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            autocomplete="email"
            aria-required="true"
            required
          >
        </div>
      </div>

      <div class="contact__field">
        <label for="contact-phone">{{ 'contact.phone' | t }} <span class="contact__optional">({{ 'contact.optional' | t }})</span></label>
        <input
          id="contact-phone"
          type="tel"
          name="contact[phone]"
          value="{{ form.phone }}"
          autocomplete="tel"
        >
      </div>

      <div class="contact__field">
        <label for="contact-body">{{ 'contact.message' | t }}</label>
        <textarea
          id="contact-body"
          name="contact[body]"
          rows="6"
          required
        >{{ form.body }}</textarea>
      </div>

      <button type="submit" class="btn btn--dark contact__submit">{{ 'contact.send' | t }}</button>
    {% endform %}
    </div>

    {% if has_details %}
      <aside class="contact__details" aria-label="{{ section.settings.details_heading | escape }}">
        {% if section.settings.details_heading != blank %}
          <h2 class="contact__details-heading">{{ section.settings.details_heading }}</h2>
        {% endif %}

        {% if section.settings.email != blank %}
          <div class="contact__detail">
            <span class="contact__detail-label">{{ 'contact.email' | t }}</span>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </div>
        {% endif %}

        {% if section.settings.phone != blank %}
          <div class="contact__detail">
            <span class="contact__detail-label">{{ 'contact.phone' | t }}</span>
            <a href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}">{{ section.settings.phone }}</a>
          </div>
        {% endif %}

        {% if section.settings.address != blank %}
          <div class="contact__detail">
            <span class="contact__detail-label">{{ 'contact.visit' | t }}</span>
            <p>{{ section.settings.address | newline_to_br }}</p>
          </div>
        {% endif %}

        {% if section.settings.hours != blank %}
          <div class="contact__detail">
            <span class="contact__detail-label">{{ 'contact.hours' | t }}</span>
            <p>{{ section.settings.hours | newline_to_br }}</p>
          </div>
        {% endif %}

        {% if section.settings.note != blank %}
          <p class="contact__details-note">{{ section.settings.note }}</p>
        {% endif %}
      </aside>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .contact {
    padding-top: 48px;
    padding-bottom: 80px;
  }

  .contact__inner {
    max-width: 640px;
    margin: 0 auto;
  }

  .contact__inner--split {
    max-width: 1040px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 64px;
    align-items: start;
  }

  .contact__details {
    display: flex;
    flex-direction: column;
    gap: 22px;
    background: var(--color-background-secondary);
    color: var(--color-foreground-secondary);
    border-radius: var(--style-border-radius-inputs);
    padding: 30px 28px;
    position: sticky;
    top: 96px;
  }

  .contact__details-heading {
    margin: 0;
    font-size: 20px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .contact__detail {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .contact__detail-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact__detail a {
    font-size: 15px;
    color: var(--color-foreground);
    text-decoration-color: var(--color-accent-secondary);
  }

  .contact__detail a:hover {
    color: var(--color-accent-secondary);
  }

  .contact__detail p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
  }

  .contact__details-note {
    margin: 0;
    padding-top: 18px;
    border-top: 1px solid var(--color-input-line);
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .contact__title {
    margin: 0 0 14px;
    font-size: 42px;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .contact__intro {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
    margin-bottom: 26px;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact__success {
    margin: 0;
    padding: 14px 16px;
    background: var(--color-background-secondary);
    border-radius: var(--style-border-radius-inputs);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .contact__errors {
    padding: 14px 16px;
    border: 1px solid var(--color-accent-secondary);
    border-radius: var(--style-border-radius-inputs);
    font-size: 14px;
    color: var(--color-foreground);
  }

  .contact__errors p {
    margin: 0 0 6px;
    font-weight: 600;
  }

  .contact__errors ul {
    margin: 0;
    padding-left: 18px;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact__field label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .contact__optional {
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  .contact__field input,
  .contact__field textarea {
    border: 1px solid var(--color-input-line);
    background: var(--color-background);
    border-radius: var(--style-border-radius-inputs);
    padding: 13px 15px;
    font-family: var(--font-primary--family);
    font-size: 15px;
    color: var(--color-foreground);
    outline: none;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    border-color: var(--color-accent-secondary);
  }

  .contact__field textarea {
    resize: vertical;
  }

  .contact__submit {
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .contact__inner--split {
      grid-template-columns: 1fr;
      gap: 40px;
      max-width: 640px;
    }

    .contact__details {
      position: static;
    }
  }

  @media (max-width: 700px) {
    .contact__title {
      font-size: 32px;
    }

    .contact__row {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "header",
      "content": "Contact details",
      "info": "Shown in a panel beside the form. Leave all fields empty to hide the panel."
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Panel heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone number"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address"
    },
    {
      "type": "textarea",
      "id": "hours",
      "label": "Opening hours"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "info": "Small print under the details, such as response times."
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
