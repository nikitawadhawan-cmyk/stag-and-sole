<footer class="site-footer">
  <div class="wrap site-footer__in">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'link_column' %}
          <nav class="footer-col" aria-label="{{ block.settings.heading | escape }}" {{ block.shopify_attributes }}>
            <span class="footer-col__title">{{ block.settings.heading }}</span>
            {% for link in block.settings.menu.links %}
              {% if link.url == '#' or link.url == blank %}
                {% for child in link.links %}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {% endfor %}
              {% else %}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {% endif %}
            {% endfor %}
          </nav>
        {% when 'newsletter' %}
          <div class="footer-col footer-col--newsletter" {{ block.shopify_attributes }}>
            <span class="footer-col__title">{{ block.settings.heading }}</span>
            {% if block.settings.text != blank %}
              <p class="site-footer__newsletter-text">{{ block.settings.text }}</p>
            {% endif %}
            {% form 'customer', class: 'site-footer__newsletter' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              {% if form.posted_successfully? %}
                <p class="site-footer__newsletter-note">{{ 'newsletter.success' | t }}</p>
              {% else %}
                <div class="site-footer__newsletter-row">
                  <label class="visually-hidden" for="footer-email-{{ section.id }}">{{ 'newsletter.email_label' | t }}</label>
                  <input
                    id="footer-email-{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ 'newsletter.email_placeholder' | t }}"
                    autocomplete="email"
                    required
                  >
                  <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">
                    <svg width="26" height="20" viewBox="0 0 26 20" fill="none" aria-hidden="true">
                      <rect x="1" y="1" width="24" height="18" rx="2" stroke="currentColor" stroke-width="1.6"/>
                      <path d="M2 3l11 8L24 3" stroke="currentColor" stroke-width="1.6"/>
                    </svg>
                  </button>
                </div>
              {% endif %}
            {% endform %}
            {% if block.settings.show_social %}
              {% render 'social-icons' %}
            {% endif %}
            {% if block.settings.show_follow_on_shop %}
              <div class="site-footer__follow">
                {{ shop | login_button: action: 'follow' }}
              </div>
            {% endif %}
          </div>
      {% endcase %}
    {% endfor %}
  </div>

  <div class="wrap site-footer__bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &middot; {{ powered_by_link }}</span>

    {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
      <div class="site-footer__payment" role="list" aria-label="{{ 'footer.payment_methods' | t }}">
        {% for type in shop.enabled_payment_types %}
          {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
        {% endfor %}
      </div>
    {% endif %}

    {% if shop.policies.size > 0 %}
      <span class="site-footer__legal">
        {% for policy in shop.policies %}
          <a href="{{ policy.url }}">{{ policy.title }}</a>
        {% endfor %}
      </span>
    {% endif %}
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    margin-top: 80px;
    background: var(--color-foreground);
    color: var(--color-background);
  }

  .site-footer__in {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1.6fr;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 32px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-col__title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .footer-col a {
    font-size: 14px;
    color: var(--color-background);
    opacity: 0.85;
  }

  .footer-col a:hover {
    color: var(--color-accent-secondary);
    opacity: 1;
  }

  .footer-col--newsletter {
    gap: 16px;
  }

  .site-footer__newsletter-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    opacity: 0.75;
    max-width: 420px;
  }

  .site-footer__newsletter-row {
    display: flex;
    gap: 10px;
    align-items: center;
    border-bottom: 1.5px solid rgba(var(--color-background-rgb), 0.85);
    padding-bottom: 8px;
    max-width: 420px;
  }

  .site-footer__newsletter-row input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-primary--family);
    font-size: 15px;
    color: var(--color-background);
    padding: 6px 0;
    outline: none;
  }

  .site-footer__newsletter-row input::placeholder {
    color: rgba(var(--color-background-rgb), 0.6);
  }

  .site-footer__newsletter-row button {
    border: none;
    background: none;
    padding: 4px;
    color: var(--color-background);
    cursor: pointer;
    display: flex;
    transition: color 0.18s ease;
  }

  .site-footer__newsletter-row button:hover {
    color: var(--color-accent-secondary);
  }

  .site-footer__newsletter-note {
    margin: 0;
    font-size: 13px;
    opacity: 0.8;
  }

  .footer-col--newsletter .social {
    margin-top: 6px;
  }

  .site-footer__follow {
    margin-top: 10px;
  }

  .site-footer__bottom {
    padding-top: 20px;
    padding-bottom: 40px;
    border-top: 1px solid rgba(var(--color-background-rgb), 0.14);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    opacity: 0.75;
    gap: 16px;
    flex-wrap: wrap;
  }

  .site-footer__bottom a {
    color: var(--color-background);
  }

  .site-footer__legal {
    display: flex;
    gap: 20px;
  }

  .site-footer__payment {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .site-footer__payment svg {
    height: 24px;
    width: auto;
  }

  @media (max-width: 1024px) {
    .site-footer__in {
      grid-template-columns: 1fr 1fr;
      gap: 36px;
    }
  }

  @media (max-width: 700px) {
    .site-footer {
      margin-top: 56px;
    }

    .site-footer__in {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter signup",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "From the workshop, monthly"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "New lasts, restocks, and a fit guide worth reading. Never more than one email a month."
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social media icons",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_follow_on_shop",
          "label": "Show Follow on Shop button",
          "default": true
        }
      ]
    }
  ]
}
{% endschema %}
