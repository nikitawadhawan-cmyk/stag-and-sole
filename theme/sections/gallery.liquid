<section class="lookbook" data-reveal>
  <header class="wrap lookbook__head">
    <h1 class="lookbook__title">{{ page.title | default: section.settings.heading }}</h1>
    {% if section.settings.text != blank %}
      <p class="lookbook__intro">{{ section.settings.text }}</p>
    {% endif %}
  </header>

  <div class="lookbook__grid" data-reveal-stagger>
    {% for block in section.blocks %}
      {% liquid
        assign tile_product = block.settings.product

        # Tile image: explicit image, else the product's first lifestyle shot
        # (media not tied to a color variant), else its featured image.
        assign tile_image = block.settings.image
        if tile_image == blank and tile_product != blank
          for media in tile_product.media
            assign is_variant_media = false
            for variant in tile_product.variants
              if variant.featured_media.id == media.id
                assign is_variant_media = true
                break
              endif
            endfor
            unless is_variant_media
              assign tile_image = media.preview_image
              break
            endunless
          endfor
          if tile_image == blank
            assign tile_image = tile_product.featured_image
          endif
        endif
      %}
      <a
        {% if tile_product != blank %}
          href="{{ tile_product.url }}"
        {% endif %}
        class="lookbook__tile"
        {{ block.shopify_attributes }}
      >
        {% if tile_image %}
          {%- liquid
            assign focal_style = nil
            if tile_image.presentation.focal_point
              assign focal_style = 'object-position: ' | append: tile_image.presentation.focal_point
            endif
          -%}
          {{
            tile_image
            | image_url: width: 1400
            | image_tag: class: 'lookbook__img', widths: '600, 900, 1200, 1400', sizes: '(max-width: 900px) 100vw, 33vw', loading: 'lazy', alt: tile_image.alt,
              style: focal_style
          }}
        {% else %}
          {{ 'collection-1' | placeholder_svg_tag: 'lookbook__img' }}
        {% endif %}
        {% if tile_product != blank %}
          <span class="lookbook__overlay">
            <span class="lookbook__name">{{ tile_product.title }}</span>
            <span class="lookbook__price">
              {%- if tile_product.price_varies %}{{ 'products.from_price_html' | t: price: tile_product.price_min | money }}{% else %}{{ tile_product.price | money }}{% endif -%}
            </span>
          </span>
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .lookbook {
    padding-bottom: 10px;
  }

  .lookbook__head {
    text-align: center;
    padding-top: 34px;
    padding-bottom: 30px;
  }

  .lookbook__title {
    margin: 0;
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .lookbook__intro {
    margin: 10px auto 0;
    max-width: 480px;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .lookbook__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
  }

  .lookbook__tile {
    position: relative;
    display: block;
    aspect-ratio: 2 / 3;
    background: var(--color-background-secondary);
    overflow: hidden;
  }

  .lookbook__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lookbook__overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 22px;
    background: linear-gradient(transparent, rgba(var(--color-foreground-rgb), 0.55));
    display: flex;
    flex-direction: column;
    gap: 3px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .lookbook__tile:hover .lookbook__overlay,
  .lookbook__tile:focus-visible .lookbook__overlay {
    opacity: 1;
  }

  .lookbook__name {
    font-size: 16px;
    font-weight: 600;
    color: var(--color-background);
    letter-spacing: -0.01em;
  }

  .lookbook__price {
    font-size: 13px;
    color: var(--color-background);
    opacity: 0.85;
  }

  @media (hover: none) {
    .lookbook__overlay {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lookbook__overlay {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .lookbook__grid {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .lookbook__tile {
      aspect-ratio: 3 / 4;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gallery",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Lookbook"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "A study in leather, light, and everyday wear. Explore the season through the pairs that carry it — tap any image to shop the look."
    }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Look",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "The tile links to this product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Uses the product's lifestyle image when empty"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gallery",
      "blocks": [
        { "type": "look" },
        { "type": "look" },
        { "type": "look" }
      ]
    }
  ]
}
{% endschema %}
