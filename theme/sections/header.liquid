{% if section.settings.show_utility_bar %}
  <div class="utility">
    <div class="wrap utility__in">
      <nav class="utility__links" aria-label="{{ 'header.utility_navigation' | t }}">
        {% for link in section.settings.utility_menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      </nav>

      <div class="utility__right">
        {% if section.settings.utility_show_social %}
          {% render 'social-icons' %}
        {% endif %}

        {% if localization.available_countries.size > 1 %}
          {% form 'localization', class: 'curr-form' %}
            <details class="curr" data-dropdown>
              <summary class="curr__summary" aria-label="{{ 'header.currency' | t }}">
                {{ localization.country.name }}
                ({{ localization.country.currency.iso_code }}
                {{ localization.country.currency.symbol }})
                <svg width="9" height="9" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"/>
                </svg>
              </summary>
              <div class="curr__panel">
                {% for country in localization.available_countries %}
                  <button
                    type="submit"
                    name="country_code"
                    value="{{ country.iso_code }}"
                    class="curr__option{% if country.iso_code == localization.country.iso_code %} is-active{% endif %}"
                  >
                    <span>{{ country.name }}</span>
                    <span class="curr__code">{{ country.currency.iso_code }} {{ country.currency.symbol }}</span>
                  </button>
                {% endfor %}
              </div>
            </details>
          {% endform %}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

<header class="site-header">
  <div class="wrap site-header__in">
    <details class="menu-drawer">
      <summary class="menu-drawer__toggle" aria-label="{{ 'header.menu' | t }}">
        <span class="menu-drawer__icon" aria-hidden="true"><span></span><span></span><span></span></span>
      </summary>
      <nav class="menu-drawer__panel" aria-label="{{ 'header.primary_navigation' | t }}">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title }}</a>
          {% if link.links.size > 0 %}
            {% for child in link.links %}
              <a class="menu-drawer__child" href="{{ child.url }}">{{ child.title }}</a>
              {% for grandchild in child.links %}
                <a class="menu-drawer__grandchild" href="{{ grandchild.url }}">{{ grandchild.title }}</a>
              {% endfor %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      </nav>
    </details>

    <nav class="site-nav" aria-label="{{ 'header.primary_navigation' | t }}">
      {% for link in section.settings.menu.links %}
        {% if link.links.size > 0 %}
          <details class="site-nav__item">
            <summary
              {% if link.current %}
                aria-current="page"
              {% endif %}
            >
              {{ link.title }}
              <svg class="site-nav__caret" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            </summary>
            <div class="mega">
              <div class="wrap mega__in">
                <div class="mega__cols">
                  {% liquid
                    assign has_standalone = false
                    for child in link.links
                      if child.links.size == 0
                        assign has_standalone = true
                      endif
                    endfor
                  %}
                  {% if has_standalone %}
                    <div class="mega__col">
                      <span class="mega__title">{{ link.title }}</span>
                      {% for child in link.links %}
                        {% if child.links.size == 0 %}
                          <a href="{{ child.url }}">{{ child.title }}</a>
                        {% endif %}
                      {% endfor %}
                    </div>
                  {% endif %}
                  {% for child in link.links %}
                    {% if child.links.size > 0 %}
                      <div class="mega__col">
                        <a class="mega__title" href="{{ child.url }}">{{ child.title }}</a>
                        {% for grandchild in child.links %}
                          <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                        {% endfor %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>

                {% if section.blocks.size > 0 %}
                  <div class="mega__promos">
                    {% for block in section.blocks %}
                      {% if block.type == 'mega_promo' %}
                        <a
                          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                          class="mega__promo"
                          {{ block.shopify_attributes }}
                        >
                          {% if block.settings.image %}
                            {{
                              block.settings.image
                              | image_url: width: 800
                              | image_tag: class: 'mega__promo-img', widths: '400, 600, 800', sizes: '380px', loading: 'lazy'
                            }}
                          {% else %}
                            {% assign promo_placeholder = forloop.index0 | modulo: 3 | plus: 1 %}
                            <img
                              src="{{ 'placeholder-cat-' | append: promo_placeholder | append: '.jpg' | asset_url }}"
                              class="mega__promo-img"
                              alt=""
                              width="800"
                              height="500"
                              loading="lazy"
                            >
                          {% endif %}
                          <span class="mega__promo-overlay">
                            <span class="mega__promo-heading">{{ block.settings.heading }}</span>
                            {% if block.settings.text != blank %}
                              <span class="mega__promo-text">{{ block.settings.text }}</span>
                            {% endif %}
                          </span>
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          </details>
        {% else %}
          <a
            href="{{ link.url }}"
            {% if forloop.last and section.settings.accent_last_link %}
              class="is-accent"
            {% endif %}
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{- link.title -}}
          </a>
        {% endif %}
      {% endfor %}
    </nav>

    {% render 'logo', logo_image: section.settings.logo, link: true %}

    <div class="header-actions">
      <header-search class="hsearch" data-predictive-url="{{ routes.predictive_search_url }}">
        <form action="{{ routes.search_url }}" method="get" role="search" class="hsearch__form">
          <input
            type="search"
            name="q"
            placeholder="{{ 'header.search_placeholder' | t }}"
            aria-label="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            class="hsearch__input"
            data-search-input
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="hsearch__submit" aria-label="{{ 'search.submit' | t }}">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="7" cy="7" r="5.2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </form>
        <div class="hsearch__panel" data-predictive-results hidden></div>
      </header-search>
      <a href="{{ routes.search_url }}" class="hsearch-mobile" aria-label="{{ 'header.search' | t }}">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="7" cy="7" r="5.2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>

      {% if section.settings.wishlist_page != blank %}
        {% assign wishlist_page = pages[section.settings.wishlist_page] %}
        <a href="{{ wishlist_page.url }}" class="bag header-actions__wishlist">
          {{ 'wishlist.title' | t }}
          <wishlist-count class="bag__count" hidden></wishlist-count>
        </a>
      {% endif %}
      {% if shop.customer_accounts_enabled %}
        <shopify-account menu="{{ section.settings.customer_account_menu }}">
          {{ 'header.account' | t }}
        </shopify-account>
      {% endif %}
      <a href="{{ routes.cart_url }}" class="bag" data-cart-bag>
        {{ 'header.bag' | t }}
        {% if cart.item_count > 0 %}
          <span class="bag__count" aria-hidden="true">{{ cart.item_count }}</span>
          <span class="visually-hidden">{{ 'header.cart_count' | t: count: cart.item_count }}</span>
        {% endif %}
      </a>
    </div>
  </div>
</header>

{% render 'cart-drawer' %}

<script src="{{ 'cart.js' | asset_url }}" defer></script>
<script src="{{ 'search.js' | asset_url }}" defer></script>

{% stylesheet %}
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(var(--color-background-rgb), 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__in {
    height: 82px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .site-nav {
    display: flex;
    gap: 26px;
    font-size: 14px;
    font-weight: 500;
    justify-content: flex-end;
    padding-right: 48px;
  }

  .site-nav a.is-accent {
    color: var(--color-accent-secondary);
  }

  .site-nav__item summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .site-nav__item summary::-webkit-details-marker {
    display: none;
  }

  .site-nav__item summary:hover {
    color: var(--color-accent-secondary);
  }

  .site-nav__caret {
    color: var(--color-muted);
    transition: transform 0.2s ease;
  }

  .site-nav__item[open] .site-nav__caret {
    transform: rotate(180deg);
  }

  .mega {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
    animation: mega-in 0.25s ease;
  }

  @keyframes mega-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  .mega__in {
    display: flex;
    gap: 64px;
    padding-top: 40px;
    padding-bottom: 48px;
  }

  .mega__cols {
    display: flex;
    gap: 64px;
  }

  .mega__col {
    display: flex;
    flex-direction: column;
    gap: 13px;
    min-width: 150px;
  }

  .mega__col a {
    font-size: 15px;
    font-weight: 400;
  }

  .mega__title {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  a.mega__title:hover {
    color: var(--color-accent-secondary);
  }

  .mega__promos {
    margin-left: auto;
    display: grid;
    grid-template-columns: repeat(2, minmax(260px, 380px));
    gap: 16px;
  }

  .mega__promo {
    position: relative;
    aspect-ratio: 8 / 5;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background-secondary);
    display: block;
  }

  .mega__promo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mega__promo-overlay {
    position: absolute;
    inset: auto 0 0 0;
    padding: 18px;
    background: linear-gradient(transparent, rgba(var(--color-foreground-rgb), 0.6));
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .mega__promo-heading {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-background);
    letter-spacing: -0.01em;
  }

  .mega__promo-text {
    font-size: 12px;
    color: var(--color-background);
    opacity: 0.85;
  }

  @media (max-width: 1180px) {
    .mega__promos {
      grid-template-columns: minmax(240px, 320px);
    }

    .mega__promos .mega__promo:nth-child(2) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mega {
      animation: none;
    }

    .site-nav__caret {
      transition: none;
    }
  }

  .header-actions {
    display: flex;
    gap: 22px;
    justify-content: flex-end;
    align-items: center;
    font-size: 14px;
    font-weight: 500;
  }

  .header-actions shopify-account {
    display: flex;
    align-items: center;
  }

  .bag {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .bag__count {
    min-width: 20px;
    height: 20px;
    border-radius: 10px;
    background: var(--color-foreground);
    color: var(--color-background);
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 6px;
  }

  .menu-drawer {
    display: none;
  }

  .menu-drawer__toggle {
    list-style: none;
    cursor: pointer;
    padding: 10px 10px 10px 0;
  }

  .menu-drawer__toggle::-webkit-details-marker {
    display: none;
  }

  .menu-drawer__icon {
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 22px;
  }

  .menu-drawer__icon span {
    height: 1.5px;
    background: var(--color-foreground);
  }

  .menu-drawer__panel {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
    display: flex;
    flex-direction: column;
    padding: 10px var(--page-margin) 22px;
  }

  .menu-drawer__panel a {
    padding: 12px 0;
    font-size: 16px;
    font-weight: 500;
    border-bottom: 1px solid var(--color-line);
  }

  .menu-drawer__child {
    padding-left: 18px !important;
    font-size: 14px !important;
    color: var(--color-muted);
  }

  .menu-drawer__grandchild {
    padding-left: 36px !important;
    font-size: 13px !important;
    color: var(--color-muted);
  }

  .hsearch {
    display: block;
    position: relative;
  }

  .hsearch__form {
    display: flex;
    align-items: center;
    border: 1px solid var(--color-input-line);
    border-radius: 999px;
    background: var(--color-background);
    padding: 0 4px 0 14px;
    transition: border-color 0.18s ease, width 0.25s ease;
    width: 190px;
  }

  .hsearch__form:focus-within {
    border-color: var(--color-foreground);
    width: 250px;
  }

  .hsearch__input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-primary--family);
    font-size: 13px;
    color: var(--color-foreground);
    padding: 9px 0;
    outline: none;
  }

  .hsearch__input::-webkit-search-cancel-button {
    display: none;
  }

  .hsearch__submit {
    border: none;
    background: none;
    color: var(--color-muted);
    padding: 7px;
    cursor: pointer;
    display: flex;
  }

  .hsearch__submit:hover {
    color: var(--color-foreground);
  }

  .hsearch__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 420px;
    max-height: 70vh;
    overflow-y: auto;
    background: var(--color-background);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 4px 20px 20px;
    z-index: 60;
  }

  .hsearch__panel .predictive__products {
    grid-template-columns: 1fr;
  }

  .hsearch__panel.is-loading {
    opacity: 0.6;
  }

  .hsearch-mobile {
    display: none;
    color: var(--color-foreground);
    padding: 6px;
  }

  .utility {
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
  }

  .utility__in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 46px;
  }

  .utility__links {
    display: flex;
    gap: 22px;
    font-size: 13.5px;
    font-weight: 500;
  }

  .utility__right {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .utility .social {
    gap: 14px;
  }

  .utility .social svg {
    width: 19px;
    height: 19px;
  }

  @media (max-width: 700px) {
    .utility .social,
    .utility__links {
      display: none;
    }

    .utility__in {
      justify-content: flex-end;
      min-height: 40px;
    }
  }

  .curr {
    position: relative;
  }

  .curr__summary {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
    padding: 8px 2px;
  }

  .curr__summary::-webkit-details-marker {
    display: none;
  }

  .curr__summary:hover {
    color: var(--color-accent-secondary);
  }

  .curr__summary svg {
    color: var(--color-muted);
    transition: transform 0.2s ease;
  }

  .curr[open] .curr__summary svg {
    transform: rotate(180deg);
  }

  .curr__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 230px;
    max-height: 320px;
    overflow-y: auto;
    background: var(--color-background);
    border: 1px solid var(--color-line);
    border-radius: 4px;
    padding: 8px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    scrollbar-width: thin;
    scrollbar-color: var(--color-input-line) transparent;
  }

  .curr__panel::-webkit-scrollbar {
    width: 6px;
  }

  .curr__panel::-webkit-scrollbar-thumb {
    background: var(--color-input-line);
    border-radius: 3px;
  }

  .curr__option {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    align-items: baseline;
    border: none;
    background: none;
    padding: 9px 10px;
    border-radius: 3px;
    font-family: var(--font-primary--family);
    font-size: 13px;
    color: var(--color-foreground);
    text-align: left;
    cursor: pointer;
  }

  .curr__option:hover {
    background: var(--color-background-secondary);
  }

  .curr__option.is-active {
    font-weight: 600;
  }

  .curr__code {
    font-size: 12px;
    color: var(--color-muted);
  }

  @media (max-width: 1180px) {
    .hsearch__form {
      width: 150px;
    }

    .hsearch__form:focus-within {
      width: 200px;
    }
  }

  @media (max-width: 700px) {
    .hsearch {
      display: none;
    }

    .hsearch-mobile {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hsearch__form,
    .curr__summary svg {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .site-nav {
      display: none;
    }

    .menu-drawer {
      display: block;
    }

    .site-header__in {
      grid-template-columns: auto 1fr auto;
      gap: 16px;
      height: 68px;
    }

    .header-actions {
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Shows a stacked wordmark from your store name when empty"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "accent_last_link",
      "label": "Highlight last menu item",
      "default": false
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "page",
      "id": "wishlist_page",
      "label": "Wishlist page",
      "info": "Use a page with the wishlist template. Leave empty to hide the link."
    },
    {
      "type": "header",
      "content": "Utility bar"
    },
    {
      "type": "checkbox",
      "id": "show_utility_bar",
      "label": "Show utility bar",
      "default": true
    },
    {
      "type": "link_list",
      "id": "utility_menu",
      "label": "Utility menu"
    },
    {
      "type": "checkbox",
      "id": "utility_show_social",
      "label": "Show social media icons",
      "default": true
    }
  ],
  "max_blocks": 2,
  "blocks": [
    {
      "type": "mega_promo",
      "name": "Menu promo card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "8:5 aspect ratio recommended"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "New this season"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
