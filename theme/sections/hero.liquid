<section class="wrap hero">
  <div class="hero__copy">
    {% if section.settings.eyebrow != blank %}
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}

    <h1 class="hero__title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank -%}
        <br><span class="serif">{{ section.settings.heading_accent }}</span>
      {%- endif -%}
    </h1>

    {% if section.settings.text != blank %}
      <p class="hero__lede">{{ section.settings.text }}</p>
    {% endif %}

    <div class="hero__ctas">
      {% if section.settings.button_primary_label != blank %}
        <a href="{{ section.settings.button_primary_link | default: routes.all_products_collection_url }}" class="btn btn--dark">
          {{- section.settings.button_primary_label -}}
        </a>
      {% endif %}
      {% if section.settings.button_secondary_label != blank %}
        <a href="{{ section.settings.button_secondary_link | default: routes.all_products_collection_url }}" class="btn btn--outline">
          {{- section.settings.button_secondary_label -}}
        </a>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="hero__points">
        {% for block in section.blocks %}
          {% unless forloop.first %}
            <span class="hero__dot" aria-hidden="true">&middot;</span>
          {% endunless %}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="hero__media">
    {% if section.settings.image %}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag: class: 'hero__img', widths: '600, 900, 1200, 1600', sizes: '(max-width: 1024px) 100vw, 55vw', fetchpriority: 'high'
      }}
    {% else %}
      <img
        src="{{ 'placeholder-hero.jpg' | asset_url }}"
        class="hero__img"
        alt=""
        width="1200"
        height="1500"
        fetchpriority="high"
      >
    {% endif %}

    {% liquid
      assign card_product = section.settings.featured_product
    %}
    {% if card_product != blank %}
      <a href="{{ card_product.url }}" class="hero__card">
        <span class="hero__card-name">{{ card_product.title }}</span>
        <span class="hero__card-price">
          {{- card_product.price | money -}}
          {%- if card_product.price_varies %}+{% endif -%}
        </span>
      </a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .hero {
    padding-top: 32px;
    display: grid;
    grid-template-columns: 1fr 1.12fr;
    gap: 56px;
    align-items: center;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 26px;
    padding: 32px 0 56px;
  }

  .hero__title {
    margin: 0;
    font-size: 76px;
    line-height: 0.94;
    letter-spacing: -0.04em;
    font-weight: 600;
    text-wrap: balance;
  }

  .hero__title .serif {
    letter-spacing: -0.02em;
    color: var(--color-accent);
  }

  .hero__lede {
    margin: 0;
    max-width: 400px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--color-muted);
    text-wrap: pretty;
  }

  .hero__ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .hero__points {
    display: flex;
    gap: 22px;
    padding-top: 6px;
    font-size: 13px;
    color: var(--color-muted);
    flex-wrap: wrap;
  }

  .hero__dot {
    opacity: 0.5;
  }

  .hero__media {
    position: relative;
    height: 600px;
    background: var(--color-background-secondary);
    border-radius: 4px;
    overflow: hidden;
  }

  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__card {
    position: absolute;
    left: 22px;
    bottom: 22px;
    background: var(--color-background);
    padding: 13px 17px;
    border-radius: var(--style-border-radius-inputs);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .hero__card-name {
    font-size: 14px;
    font-weight: 600;
  }

  .hero__card-price {
    font-size: 13px;
    color: var(--color-muted);
  }

  @media (max-width: 1180px) {
    .hero__title {
      font-size: 62px;
    }
  }

  @media (max-width: 1024px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .hero__copy {
      padding: 24px 0 8px;
    }

    .hero__media {
      height: 480px;
    }
  }

  @media (max-width: 700px) {
    .hero__title {
      font-size: 47px;
    }

    .hero__media {
      height: 420px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to be"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent heading",
      "info": "Shows on a second line in the accent font",
      "default": "worn out."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body text",
      "default": "Everyday shoes on full-grain leather with a sole that survives the commute. Honest pricing, no seasonal markup games."
    },
    {
      "type": "text",
      "id": "button_primary_label",
      "label": "Primary button label",
      "default": "Shop all shoes"
    },
    {
      "type": "url",
      "id": "button_primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_secondary_label",
      "label": "Secondary button label",
      "default": "See new arrivals"
    },
    {
      "type": "url",
      "id": "button_secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "3:4 aspect ratio recommended"
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product card"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Selling point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Full-grain leather"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "point" },
        { "type": "point", "settings": { "text": "Cushioned insole" } },
        { "type": "point", "settings": { "text": "Direct pricing" } }
      ]
    }
  ]
}
{% endschema %}
