          "value": "workshop",
          "label": "Workshop"
        },
        {
          "value": "street",
          "label": "Street"
        },
        {
          "value": "formal",
          "label": "Formal shoes"
        },
        {
          "value": "sneakers",
          "label": "Sneakers"
        },
        {
          "value": "loafers",
          "label": "Loafers"
        },
        {
          "value": "cafe",
          "label": "Cafe"
        },
        {
          "value": "scooter",
          "label": "Scooter"
        },
        {
          "value": "bench",
          "label": "Park bench"
        },
        {
          "value": "unboxing",
          "label": "Unboxing"
        },
        {
          "value": "doorway",
          "label": "Doorway"
        },
        {
          "value": "boots",
          "label": "Boots studio"
        },
        {
          "value": "runners",
          "label": "White sneakers studio"
        },
        {
          "value": "stride",
          "label": "Street stride"
        }
      ],
      "default": "workshop"
