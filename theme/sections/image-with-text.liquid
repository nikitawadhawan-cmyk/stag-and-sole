<section class="wrap iwt{% if section.settings.image_position == 'left' %} iwt--flip{% endif %}" data-reveal>
  <div class="iwt__copy">
    {% if section.settings.eyebrow != blank %}
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    <h2 class="iwt__title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank %}
        <span class="serif iwt__accent">{{ section.settings.heading_accent }}</span>
      {%- endif -%}
    </h2>
    {% if section.settings.text != blank %}
      <div class="iwt__body rte">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--outline iwt__btn">
        {{- section.settings.button_label -}}
      </a>
    {% endif %}
  </div>

  <div class="iwt__media">
    {% if section.settings.image %}
      {%- liquid
        assign focal_style = nil
        if section.settings.image.presentation.focal_point
          assign focal_style = 'object-position: ' | append: section.settings.image.presentation.focal_point
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag: class: 'iwt__img', widths: '600, 900, 1200', sizes: '(max-width: 1024px) 100vw, 50vw', loading: 'lazy', alt: section.settings.image.alt,
          style: focal_style
      }}
    {% else %}
      {% render 'placeholder-image', name: section.settings.placeholder_image, class: 'iwt__img' %}
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .iwt {
    padding-top: 76px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: center;
  }

  .iwt--flip .iwt__copy {
    order: 2;
  }

  .iwt--flip .iwt__media {
    order: 1;
  }

  .iwt__copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-items: flex-start;
  }

  .iwt__title {
    margin: 0;
    font-size: 38px;
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    text-wrap: balance;
  }

  .iwt__accent {
    color: var(--color-accent);
  }

  .iwt__body {
    font-size: 15.5px;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 460px;
  }

  .iwt__btn {
    margin-top: 6px;
  }

  .iwt__media {
    aspect-ratio: 5 / 4;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background-secondary);
  }

  .iwt__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1024px) {
    .iwt {
      grid-template-columns: 1fr;
      gap: 26px;
      padding-top: 56px;
    }

    .iwt--flip .iwt__copy {
      order: 1;
    }

    .iwt--flip .iwt__media {
      order: 2;
    }

    .iwt__title {
      font-size: 30px;
    }
  }
{% endstylesheet %}

{% schema %}
