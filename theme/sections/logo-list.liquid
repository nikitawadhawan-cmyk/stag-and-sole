<section class="logo-list{% if section.settings.show_band %} logo-list--band{% endif %}" data-reveal>
  <div class="wrap logo-list__in">
    {% if section.settings.heading != blank %}
      <span class="logo-list__heading">{{ section.settings.heading }}</span>
    {% endif %}
    <div class="logo-list__row">
      {% for block in section.blocks %}
        {% liquid
          assign logo_content = ''
        %}
        {% capture logo_content %}
          {% if block.settings.image %}
            {{
              block.settings.image
              | image_url: width: 320
              | image_tag: class: 'logo-list__img', widths: '160, 320', sizes: '140px', loading: 'lazy', alt: block.settings.image.alt
            }}
          {% else %}
            <span class="logo-list__placeholder">{{ block.settings.label | default: 'Logo' }}</span>
          {% endif %}
        {% endcapture %}
        {% if block.settings.link != blank %}
          <a href="{{ block.settings.link }}" class="logo-list__item" {{ block.shopify_attributes }} aria-label="{{ block.settings.label | default: 'Logo' | escape }}">
            {{ logo_content }}
          </a>
        {% else %}
          <div class="logo-list__item" {{ block.shopify_attributes }}>
            {{ logo_content }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .logo-list {
    padding: 34px 0;
  }

  .logo-list--band {
    background: var(--color-background-secondary);
    color: var(--color-foreground-secondary);
  }

  .logo-list__in {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .logo-list__heading {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .logo-list__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 26px 48px;
  }

  .logo-list__item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    transition: opacity 0.18s ease;
  }

  .logo-list__item:hover {
    opacity: 1;
  }

  .logo-list__img {
    max-height: 34px;
    width: auto;
    max-width: 140px;
    object-fit: contain;
    filter: grayscale(1);
  }

  .logo-list__item:hover .logo-list__img {
    filter: none;
  }

  .logo-list__placeholder {
    font-family: var(--font-accent--family);
    font-size: 22px;
    font-style: italic;
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (max-width: 700px) {
    .logo-list__row {
      gap: 18px 30px;
    }

    .logo-list__img {
      max-height: 26px;
      max-width: 110px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-list__item {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Logo list",
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As featured in"
    },
    {
      "type": "checkbox",
      "id": "show_band",
      "label": "Show background band",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "140 x 60px .png recommended"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Name",
          "info": "Shown while no image is selected, and read by screen readers."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo", "settings": { "label": "Meridian" } },
        { "type": "logo", "settings": { "label": "The Sartorial" } },
        { "type": "logo", "settings": { "label": "Field Notes" } },
        { "type": "logo", "settings": { "label": "Atelier Weekly" } },
        { "type": "logo", "settings": { "label": "Craft & Co" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
