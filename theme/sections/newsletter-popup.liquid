{% if section.settings.enabled %}
  <newsletter-popup
    class="npopup"
    data-trigger-percent="{{ section.settings.trigger_percent }}"
    data-days-between="{{ section.settings.days_between }}"
    hidden
  >
    <div class="npopup__overlay" data-popup-close aria-hidden="true"></div>
    <div class="npopup__card" role="dialog" aria-modal="true" aria-label="{{ section.settings.heading | escape }}">
      <button type="button" class="npopup__close" data-popup-close aria-label="{{ 'general.close' | t }}">&times;</button>

      <div class="npopup__media">
        {% if section.settings.image %}
          {{
            section.settings.image
            | image_url: width: 800
            | image_tag: class: 'npopup__img', widths: '400, 600, 800', sizes: '340px', loading: 'lazy'
          }}
        {% else %}
          {% render 'placeholder-image', name: section.settings.placeholder_image, class: 'npopup__img' %}
        {% endif %}
      </div>

      <div class="npopup__content">
        {% if section.settings.eyebrow != blank %}
          <div class="eyebrow">{{ section.settings.eyebrow }}</div>
        {% endif %}
        <h2 class="npopup__title">
          {{ section.settings.heading }}
          {%- if section.settings.heading_accent != blank %}
            <span class="serif npopup__accent">{{ section.settings.heading_accent }}</span>
          {%- endif -%}
        </h2>

        {% form 'customer', class: 'npopup__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter,popup">
          {% if form.posted_successfully? %}
            <p class="npopup__success">{{ 'newsletter.success' | t }}</p>
          {% else %}
            {% if form.errors %}
              <p class="npopup__error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {% endif %}
            <div class="npopup__row">
              <label class="visually-hidden" for="popup-email-{{ section.id }}">{{ 'newsletter.email_label' | t }}</label>
              <input
                id="popup-email-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ 'newsletter.email_placeholder' | t }}"
                autocomplete="email"
                required
              >
              <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M2 10L18 2l-4.5 16-4-6.5L2 10z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {% endif %}
        {% endform %}

        {% if section.settings.text != blank %}
          <p class="npopup__text">{{ section.settings.text }}</p>
        {% endif %}

        {% if section.settings.show_social %}
          {% render 'social-icons' %}
        {% endif %}
      </div>
    </div>
  </newsletter-popup>
{% endif %}

{% stylesheet %}
  .npopup {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 110;
  }

  .npopup[hidden] {
    display: none;
  }

  .npopup__overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--color-foreground-rgb), 0.45);
  }

  .npopup__card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(760px, calc(100vw - 32px));
    background: var(--color-background);
    border-radius: 4px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 320px 1fr;
    animation: npopup-in 0.3s ease;
  }

  @keyframes npopup-in {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 14px));
    }

    to {
      opacity: 1;
      transform: translate(-50%, -50%);
    }
  }

  .npopup__close {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-background);
    font-size: 20px;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
  }

  .npopup__close:hover {
    color: var(--color-foreground);
    border-color: var(--color-foreground);
  }

  .npopup__media {
    background: var(--color-background-secondary);
  }

  .npopup__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .npopup__content {
    padding: 40px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .npopup__title {
    margin: 0;
    font-size: 34px;
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-weight: 600;
    text-wrap: balance;
  }

  .npopup__accent {
    color: var(--color-accent);
  }

  .npopup__row {
    display: flex;
    gap: 10px;
    align-items: center;
    border-bottom: 1.5px solid var(--color-foreground);
    padding-bottom: 8px;
  }

  .npopup__row input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font-family: var(--font-primary--family);
    font-size: 15px;
    color: var(--color-foreground);
    padding: 6px 0;
    outline: none;
  }

  .npopup__row button {
    border: none;
    background: var(--color-foreground);
    color: var(--color-background);
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .npopup__row button:hover {
    background: var(--color-accent);
  }

  .npopup__success {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .npopup__error {
    margin: 0;
    font-size: 13px;
    color: var(--color-accent-secondary);
  }

  .npopup__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .npopup__card {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .npopup__card {
      grid-template-columns: 1fr;
    }

    .npopup__media {
      display: none;
    }

    .npopup__content {
      padding: 32px 24px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class NewsletterPopup extends HTMLElement {
    connectedCallback() {
      const KEY = 'stag:newsletter-popup';
      const daysBetween = parseInt(this.dataset.daysBetween, 10) || 30;

      this.addEventListener('click', (event) => {
        if (event.target.closest('[data-popup-close]')) this.close(KEY);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !this.hidden) this.close(KEY);
      });

      /* Successful signup: show the confirmation once, then never again. */
      if (this.querySelector('.npopup__success')) {
        this.hidden = false;
        localStorage.setItem(KEY, String(Date.now() + 365 * 86400000));
        return;
      }

      const until = parseInt(localStorage.getItem(KEY) || '0', 10);
      if (Date.now() < until) return;

      const percent = (parseInt(this.dataset.triggerPercent, 10) || 50) / 100;
      const onScroll = () => {
        const doc = document.documentElement;
        const scrollable = doc.scrollHeight - window.innerHeight;
        if (scrollable <= 0) return;
        if (window.scrollY / scrollable >= percent) {
          window.removeEventListener('scroll', onScroll);
          this.hidden = false;
          localStorage.setItem(KEY, String(Date.now() + parseInt(this.dataset.daysBetween || '30', 10) * 86400000));
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    }

    close(KEY) {
      this.hidden = true;
      localStorage.setItem(KEY, String(Date.now() + (parseInt(this.dataset.daysBetween, 10) || 30) * 86400000));
    }
  }

  customElements.define('newsletter-popup', NewsletterPopup);
{% endjavascript %}

{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable popup",
      "default": false
    },
    {
      "type": "range",
      "id": "trigger_percent",
      "min": 10,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Show after scrolling",
      "default": 50
    },
    {
      "type": "range",
      "id": "days_between",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "d",
      "label": "Days before showing again",
      "default": 30
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "2:3 aspect ratio recommended"
    },
    {
      "type": "select",
      "id": "placeholder_image",
      "label": "Placeholder image",
      "info": "Shows until an image is selected",
      "options": [
        { "value": "workshop", "label": "Workshop" },
        { "value": "street", "label": "Street" },
        { "value": "formal", "label": "Formal shoes" },
        { "value": "sneakers", "label": "Sneakers" },
        { "value": "loafers", "label": "Loafers" },
        { "value": "cafe", "label": "Cafe" },
        { "value": "scooter", "label": "Scooter" },
        { "value": "bench", "label": "Park bench" },
        { "value": "unboxing", "label": "Unboxing" },
        { "value": "doorway", "label": "Doorway" }
      ],
      "default": "street"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New here?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% off"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent text",
      "info": "Shows on a second line in the accent font",
      "default": "your first pair."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Join the list for new lasts, restocks, and the annual sale. Never more than one email a month."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social media icons",
      "default": true
    }
  ]
}
{% endschema %}
