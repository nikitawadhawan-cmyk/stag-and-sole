<main class="pw">
  <div class="pw__card">
    {% render 'logo', link: false %}

    <h1 class="pw__title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank %}
        <span class="serif pw__accent">{{ section.settings.heading_accent }}</span>
      {%- endif %}
    </h1>

    {% if shop.password_message != blank %}
      <p class="pw__message">{{ shop.password_message }}</p>
    {% elsif section.settings.text != blank %}
      <p class="pw__message">{{ section.settings.text }}</p>
    {% endif %}

    <details class="pw__enter">
      <summary>{{ 'password.enter_password' | t }}</summary>
      {% form 'storefront_password', class: 'pw__form' %}
        {% if form.errors %}
          <p class="pw__error" role="alert">{{ 'password.wrong_password' | t }}</p>
        {% endif %}
        <label class="visually-hidden" for="pw-input">{{ 'password.password' | t }}</label>
        <div class="pw__row">
          <input
            id="pw-input"
            type="password"
            name="password"
            placeholder="{{ 'password.password' | t }}"
            autocomplete="current-password"
            required
          >
          <button type="submit">{{ 'password.enter' | t }}</button>
        </div>
      {% endform %}
    </details>
  </div>

  <footer class="pw__foot">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
  </footer>
</main>

{% stylesheet %}
  .pw {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    text-align: center;
  }

  .pw__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    max-width: 440px;
  }

  .pw__title {
    margin: 8px 0 0;
    font-size: 40px;
    letter-spacing: -0.035em;
    font-weight: 600;
    line-height: 1.05;
  }

  .pw__accent {
    color: var(--color-accent);
  }

  .pw__message {
    margin: 0;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
  }

  .pw__enter {
    margin-top: 8px;
  }

  .pw__enter summary {
    list-style: none;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pw__enter summary::-webkit-details-marker {
    display: none;
  }

  .pw__enter summary:hover {
    color: var(--color-accent-secondary);
  }

  .pw__form {
    margin-top: 16px;
  }

  .pw__error {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent-secondary);
  }

  .pw__row {
    display: flex;
    gap: 10px;
  }

  .pw__row input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-input-line);
    background: var(--color-background);
    border-radius: var(--style-border-radius-inputs);
    padding: 14px 16px;
    font-family: var(--font-primary--family);
    font-size: 14px;
    color: var(--color-foreground);
    outline: none;
  }

  .pw__row input:focus {
    border-color: var(--color-accent-secondary);
  }

  .pw__row button {
    padding: 14px 24px;
    border: none;
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-primary--family);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }

  .pw__foot {
    position: fixed;
    bottom: 24px;
    font-size: 12px;
    color: var(--color-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent word",
      "default": "soon."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Fallback message",
      "info": "Shows when no password page message is set in preferences",
      "default": "Something worth waiting for is on the bench. Check back shortly."
    }
  ]
}
{% endschema %}
