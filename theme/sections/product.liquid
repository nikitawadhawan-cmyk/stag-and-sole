    {
      "type": "pickup",
      "name": "Pickup availability",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible",
      "name": "Collapsible rows",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "open_first",
          "label": "Open first row by default",
          "default": true
        },
        {
          "type": "text",
          "id": "heading_1",
          "label": "First heading",
          "default": "Description"
        },
        {
          "type": "richtext",
          "id": "content_1",
          "label": "First content",
          "default": "<p>Tell the full story of this product: the materials, the construction, and why it earns a place in the rotation.</p>"
        },
        {
          "type": "text",
