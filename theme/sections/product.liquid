{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign active_media_id = featured_media.id | default: product.media.first.id

  # Which option is the color option, and which color is selected? Media tied
  # to other colors (via variant featured media) is hidden until selected.
  assign color_option_index = -1
  assign size_option_index = -1
  for option in product.options_with_values
    assign option_name_down = option.name | downcase
    if option_name_down == 'color' or option_name_down == 'colour'
      assign color_option_index = forloop.index0
    elsif option_name_down == 'size'
      assign size_option_index = forloop.index0
    endif
  endfor
  assign selected_color = ''
  if color_option_index > -1
    assign selected_color = current_variant.options[color_option_index]
  endif
%}

<script src="{{ 'product.js' | asset_url }}" defer></script>

{% if section.settings.show_breadcrumbs %}
  <nav class="wrap crumbs" aria-label="{{ 'general.breadcrumbs' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>
    {% if product.collections.first %}
      <span class="crumbs__sep" aria-hidden="true">/</span>
      <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
    {% endif %}
    <span class="crumbs__sep" aria-hidden="true">/</span>
    <span class="crumbs__current" aria-current="page">{{ product.title }}</span>
  </nav>
{% endif %}

<section class="wrap pdp" data-section-id="{{ section.id }}">
  <media-gallery class="pdp__gallery" data-gallery>
    {% if product.media.size > 1 %}
      <div class="pdp__thumbs" role="list">
        {% for media in product.media %}
          {% liquid
            assign media_colors = ''
            if color_option_index > -1
              for variant in product.variants
                if variant.featured_media.id == media.id
                  assign variant_color = variant.options[color_option_index]
                  unless media_colors contains variant_color
                    assign media_colors = media_colors | append: '||' | append: variant_color
                  endunless
                endif
              endfor
            endif
            assign color_hidden = false
            if media_colors != '' and selected_color != ''
              unless media_colors contains selected_color
                assign color_hidden = true
              endunless
            endif
          %}
          <button
            type="button"
            class="pdp__thumb{% if media.id == active_media_id %} is-active{% endif %}{% if color_hidden %} is-color-hidden{% endif %}"
            data-thumb-media-id="{{ media.id }}"
            {% if media_colors != '' %}
              data-media-colors="{{ media_colors | remove_first: '||' | escape }}"
            {% endif %}
            aria-label="{{ 'products.media_thumbnail' | t: index: forloop.index }}"
          >
            {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: media.preview_image.alt }}
          </button>
        {% endfor %}
      </div>
    {% endif %}

    <div class="pdp__media-main" data-gallery-main>
      {% for media in product.media %}
        {% liquid
          assign media_loading = 'lazy'
          if media.id == active_media_id
            assign media_loading = 'eager'
          endif
          assign media_colors = ''
          if color_option_index > -1
            for variant in product.variants
              if variant.featured_media.id == media.id
                assign variant_color = variant.options[color_option_index]
                unless media_colors contains variant_color
                  assign media_colors = media_colors | append: '||' | append: variant_color
                endunless
              endif
            endfor
          endif
          assign color_hidden = false
          if media_colors != '' and selected_color != ''
            unless media_colors contains selected_color
              assign color_hidden = true
            endunless
          endif
        %}
        <div
          class="pdp__media-item{% if media.id == active_media_id %} is-active{% endif %}{% if color_hidden %} is-color-hidden{% endif %}"
          data-media-id="{{ media.id }}"
          {% if media_colors != '' %}
            data-media-colors="{{ media_colors | remove_first: '||' | escape }}"
          {% endif %}
        >
          {% case media.media_type %}
            {% when 'image' %}
              {{
                media
                | image_url: width: 1400
                | image_tag:
                  class: 'pdp__img',
                  widths: '600, 900, 1200, 1400',
                  sizes: '(max-width: 1024px) 100vw, 50vw',
                  loading: media_loading,
                  alt: media.alt
              }}
            {% else %}
              {{ media | media_tag: class: 'pdp__img pdp__img--media' }}
          {% endcase %}
        </div>
      {% else %}
        <div class="pdp__media-item is-active">
          {{ 'product-1' | placeholder_svg_tag: 'pdp__img' }}
        </div>
      {% endfor %}

      {% if current_variant.compare_at_price > current_variant.price %}
        <span class="pdp__badge pdp__badge--sale">{{ 'products.on_sale' | t }}</span>
      {% elsif product.tags contains 'Bestseller' %}
        <span class="pdp__badge">{{ 'products.bestseller' | t }}</span>
      {% endif %}
    </div>
  </media-gallery>

  <div class="pdp__info">
    {% form 'product', product, id: 'pdp-form', data-pdp-form: '' %}
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@app' %}
            {% render block %}

          {% when 'custom_liquid' %}
            <div class="pdp__block" {{ block.shopify_attributes }}>
              {{ block.settings.custom_liquid }}
            </div>

          {% when 'eyebrow' %}
            <div class="pdp__eyebrow" {{ block.shopify_attributes }}>
              <span class="pdp__eyebrow-dot" aria-hidden="true"></span>
              {% if block.settings.show_vendor and product.vendor != blank %}{{ product.vendor }}{% endif %}
              {%- if block.settings.show_vendor and block.settings.show_type and product.type != blank %} &middot; {% endif -%}
              {% if block.settings.show_type %}{{ product.type }}{% endif %}
            </div>

          {% when 'title' %}
            <div class="pdp__title-row" {{ block.shopify_attributes }}>
              <h1 class="pdp__title">
                {% liquid
                  assign words = product.title | split: ' '
                %}
                {% if block.settings.accent_last_word and words.size > 1 %}
                  {% for word in words %}
                    {% if forloop.last %}
                      <span class="serif pdp__title-accent">{{ word }}</span>
                    {% else %}
                      {{ word }}
                    {% endif %}
                  {% endfor %}
                {% else %}
                  {{ product.title }}
                {% endif %}
              </h1>
              {% if block.settings.show_wishlist %}
                <wishlist-button
                  class="wish"
                  data-handle="{{ product.handle }}"
                  data-url="{{ product.url }}"
                  data-title="{{ product.title | escape }}"
                  data-image="{{ product.featured_image | image_url: width: 600 }}"
                  data-price="{{ product.price | money }}"
                  data-type="{{ product.type | escape }}"
                  data-label-add="{{ 'wishlist.add' | t }}"
                  data-label-remove="{{ 'wishlist.remove' | t }}"
                >
                  <button type="button" class="wish__btn" aria-pressed="false" aria-label="{{ 'wishlist.add' | t }}">
                    <svg width="22" height="20" viewBox="0 0 22 20" aria-hidden="true">
                      <path d="M11 18.3C8.2 16 1.5 11.2 1.5 6.4 1.5 3.7 3.6 1.5 6.2 1.5c1.9 0 3.6 1 4.8 2.8 1.2-1.8 2.9-2.8 4.8-2.8 2.6 0 4.7 2.2 4.7 4.9 0 4.8-6.7 9.6-9.5 11.9z" fill="none" stroke="currentColor" stroke-width="1.5"/>
                    </svg>
                  </button>
                </wishlist-button>
              {% endif %}
            </div>

          {% when 'price' %}
            <div class="pdp__price-area" data-swap="price" {{ block.shopify_attributes }}>
              <div class="pdp__price">
                {% if current_variant.compare_at_price > current_variant.price %}
                  <s class="pdp__compare">{{ current_variant.compare_at_price | money }}</s>
                  <span class="pdp__amount">{{ current_variant.price | money }}</span>
                  {% assign saved = current_variant.compare_at_price | minus: current_variant.price | money %}
                  <span class="pdp__save">{{ 'products.save_amount' | t: amount: saved }}</span>
                {% else %}
                  <span class="pdp__amount">{{ current_variant.price | money }}</span>
                {% endif %}
              </div>
              {% if current_variant.unit_price_measurement %}
                <div class="pdp__unit-price">
                  {{ current_variant.unit_price | money }} /
                  {{ current_variant.unit_price_measurement.reference_unit }}
                </div>
              {% endif %}
              {% if cart.taxes_included %}
                <div class="pdp__tax-note">{{ 'products.taxes_included' | t }}</div>
              {% endif %}
            </div>

          {% when 'sku' %}
            <div class="pdp__sku" data-swap="sku" {{ block.shopify_attributes }}>
              {% if current_variant.sku != blank %}
                {{ 'products.sku' | t }}: {{ current_variant.sku }}
              {% endif %}
            </div>

          {% when 'description' %}
            {% if product.description != blank %}
              <div class="pdp__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {% endif %}

          {% when 'size_chart' %}
            {% liquid
              assign chart_rows = block.settings.measurements | strip | newline_to_br | split: '<br />'
            %}
            {% if chart_rows.size > 1 %}
              <size-chart data-size-index="{{ size_option_index }}" {{ block.shopify_attributes }}>
                <button type="button" class="pdp__sizechart-btn" data-size-chart-open>
                  <span>{{ block.settings.label }}</span>
                  <svg width="24" height="15" viewBox="0 0 24 15" fill="none" aria-hidden="true">
                    <rect x="1" y="1.5" width="22" height="12" rx="3.5" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M6 1.5v4.2M10 1.5v6M14 1.5v4.2M18 1.5v6" stroke="currentColor" stroke-width="1.2"/>
                  </svg>
                </button>

                <dialog class="sizechart" aria-label="{{ block.settings.label | escape }}">
                  <div class="sizechart__head">
                    <h2 class="sizechart__title">{{ block.settings.label }}</h2>
                    <button type="button" class="sizechart__close" data-size-chart-close aria-label="{{ 'general.close' | t }}">&times;</button>
                  </div>
                  {% if block.settings.note != blank %}
                    <p class="sizechart__note">{{ block.settings.note }}</p>
                  {% endif %}
                  <table class="sizechart__table">
                    <thead>
                      <tr>
                        {% assign header_cells = chart_rows[0] | split: '|' %}
                        {% for cell in header_cells %}
                          <th scope="col">{{ cell | strip }}</th>
                        {% endfor %}
                      </tr>
                    </thead>
                    <tbody>
                      {% for row in chart_rows offset: 1 %}
                        {% assign cells = row | split: '|' %}
                        {% assign size_label = cells[0] | strip %}
                        <tr class="sizechart__row" data-chart-size="{{ size_label | escape }}">
                          <th scope="row">
                            <button type="button" class="sizechart__select" data-chart-select="{{ size_label | escape }}">
                              {{ size_label }}
                              <span class="sizechart__soldout-tag" hidden>{{ 'products.sold_out' | t }}</span>
                            </button>
                          </th>
                          {% for cell in cells offset: 1 %}
                            <td>{{ cell | strip }}</td>
                          {% endfor %}
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                  <p class="sizechart__hint">{{ 'products.size_chart_hint' | t }}</p>
                </dialog>
              </size-chart>
            {% endif %}

          {% when 'variant_picker' %}
            {% unless product.has_only_default_variant %}
              <variant-picker
                class="pdp__variants"
                data-url="{{ product.url }}"
                {% if color_option_index > -1 %}
                  data-color-index="{{ color_option_index }}"
                {% endif %}
                {{ block.shopify_attributes }}
              >
                {% for option in product.options_with_values %}
                  <fieldset class="pdp__option">
                    <legend class="pdp__option-name">
                      {{ option.name }} &mdash; <span data-selected-value>{{ option.selected_value }}</span>
                    </legend>
                    <div class="pdp__option-values">
                      {% for value in option.values %}
                        {% liquid
                          assign is_swatch = false
                          if value.swatch.color or value.swatch.image
                            assign is_swatch = true
                          endif
                        %}
                        <label class="pdp__value{% if is_swatch %} pdp__value--swatch{% endif %}">
                          <input
                            type="radio"
                            name="option-{{ option.position }}"
                            value="{{ value | escape }}"
                            data-option-position="{{ option.position }}"
                            {% if value == option.selected_value %}
                              checked
                            {% endif %}
                          >
                          {% if is_swatch %}
                            <span
                              class="pdp__swatch-dot"
                              {% if value.swatch.color %}
                                style="background: rgb({{ value.swatch.color.rgb }})"
                              {% else %}
                                style="background-image: url({{ value.swatch.image | image_url: width: 60 }})"
                              {% endif %}
                            ></span>
                            <span class="visually-hidden">{{ value }}</span>
                          {% else %}
                            <span class="pdp__value-pill">{{ value }}</span>
                          {% endif %}
                        </label>
                      {% endfor %}
                    </div>
                  </fieldset>
                {% endfor %}

                <noscript>
                  <select name="id" class="pdp__variant-select" aria-label="{{ 'products.select_variant' | t }}">
                    {% for variant in product.variants %}
                      <option
                        value="{{ variant.id }}"
                        {% if variant == current_variant %}
                          selected
                        {% endif %}
                        {% unless variant.available %}
                          disabled
                        {% endunless %}
                      >
                        {{ variant.title }} — {{ variant.price | money }}
                        {%- unless variant.available %} ({{ 'products.sold_out' | t }}){% endunless %}
                      </option>
                    {% endfor %}
                  </select>
                </noscript>

                <script type="application/json" data-variant-data>
                  [
                    {% for variant in product.variants %}
                      {
                        "id": {{ variant.id }},
                        "available": {{ variant.available }},
                        "options": {{ variant.options | json }},
                        "featured_media_id": {{ variant.featured_media.id | default: 'null' }}
                      }{% unless forloop.last %},{% endunless %}
                    {% endfor %}
                  ]
                </script>
              </variant-picker>
            {% endunless %}

          {% when 'quantity' %}
            <div class="pdp__quantity" {{ block.shopify_attributes }}>
              <label class="pdp__option-name" for="pdp-qty-{{ section.id }}">{{ 'products.quantity' | t }}</label>
              <quantity-input class="pdp__qty">
                <button type="button" class="pdp__qty-btn" data-qty-change="-1" aria-label="{{ 'products.decrease_quantity' | t }}">&minus;</button>
                <input
                  id="pdp-qty-{{ section.id }}"
                  class="pdp__qty-input"
                  type="number"
                  name="quantity"
                  value="1"
                  min="1"
                  inputmode="numeric"
                >
                <button type="button" class="pdp__qty-btn" data-qty-change="1" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
              </quantity-input>
            </div>

          {% when 'buy_buttons' %}
            <div class="pdp__buy" data-swap="buy" {{ block.shopify_attributes }}>
              {% if current_variant.available %}
                <div class="pdp__stock">
                  <span class="pdp__stock-dot" aria-hidden="true"></span>
                  {{ 'products.in_stock' | t }}
                </div>
              {% endif %}

              {% if product.gift_card? and block.settings.show_gift_card_recipient %}
                {% render 'gift-card-recipient', section: section %}
              {% endif %}

              <button
                type="submit"
                name="add"
                class="pdp__atc"
                {% unless current_variant.available %}
                  disabled
                {% endunless %}
              >
                {% liquid
                  assign price_money = current_variant.price | money
                %}
                {% if current_variant.available %}
                  {{ 'products.add_to_cart_with_price' | t: price: price_money }}
                {% else %}
                  {{ 'products.sold_out' | t }}
                {% endif %}
              </button>

              {% if block.settings.show_dynamic_checkout %}
                {{ form | payment_button }}
              {% endif %}

              {{ form | payment_terms }}
            </div>

          {% when 'pickup' %}
            <div class="pdp__pickup" data-swap="pickup" {{ block.shopify_attributes }}>
              {% assign pickup_availabilities = current_variant.store_availabilities | where: 'pick_up_enabled', true %}
              {% if pickup_availabilities.size > 0 %}
                {% assign first_pickup = pickup_availabilities.first %}
                {% if first_pickup.available %}
                  <span class="pdp__pickup-dot pdp__pickup-dot--yes" aria-hidden="true"></span>
                  <span>
                    {{ 'products.pickup_available' | t: location: first_pickup.location.name }}
                    <span class="pdp__pickup-time">({{ first_pickup.pick_up_time | downcase }})</span>
                  </span>
                {% else %}
                  <span class="pdp__pickup-dot" aria-hidden="true"></span>
                  <span>{{ 'products.pickup_unavailable' | t: location: first_pickup.location.name }}</span>
                {% endif %}
              {% endif %}
            </div>

          {% when 'collapsible' %}
            <accordion-group class="pdp__accordions" {{ block.shopify_attributes }}>
              {% assign first_open = true %}
              {% for i in (1..4) %}
                {% liquid
                  assign heading_key = 'heading_' | append: i
                  assign content_key = 'content_' | append: i
                  assign heading = block.settings[heading_key]
                  assign content = block.settings[content_key]
                %}
                {% if heading != blank and content != blank %}
                  <details
                    class="pdp__accordion"
                    name="pdp-acc-{{ section.id }}"
                    {% if first_open and block.settings.open_first %}
                      open
                    {% endif %}
                  >
                    <summary class="pdp__accordion-title">
                      {{ heading }}
                      <svg class="pdp__accordion-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"/>
                      </svg>
                    </summary>
                    <div class="pdp__accordion-body">
                      <div class="pdp__accordion-text rte">{{ content }}</div>
                    </div>
                  </details>
                  {% assign first_open = false %}
                {% endif %}
              {% endfor %}
            </accordion-group>

          {% when 'share' %}
            {% liquid
              assign share_url = shop.url | append: product.url | url_encode
            %}
            <div class="pdp__share" {{ block.shopify_attributes }}>
              <a
                href="https://www.facebook.com/sharer/sharer.php?u={{ share_url }}"
                target="_blank"
                rel="noopener nofollow"
              >
                {{- 'products.share' | t -}}
              </a>
              <a
                href="https://pinterest.com/pin/create/button/?url={{ share_url }}&media={{ product.featured_image | image_url: width: 1200 | url_encode }}&description={{ product.title | url_encode }}"
                target="_blank"
                rel="noopener nofollow"
              >
                {{- 'products.pin_it' | t -}}
              </a>
              <button type="button" class="pdp__copy-link" data-copy-link data-copied-label="{{ 'products.link_copied' | t }}">
                {{- 'products.copy_link' | t -}}
              </button>
            </div>

          {% when 'text' %}
            {% if block.settings.text != blank %}
              <p class="pdp__text-block" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {% endif %}
        {% endcase %}
      {% endfor %}
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .pdp {
    padding-top: 26px;
    padding-bottom: 80px;
    display: grid;
    grid-template-columns: 58fr 42fr;
    gap: 56px;
    align-items: start;
  }

  .pdp__gallery {
    position: sticky;
    top: 106px;
    display: flex;
    gap: 16px;
  }

  .pdp__thumbs {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: none;
  }

  .pdp__thumb {
    width: 76px;
    height: 76px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-background-secondary);
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .pdp__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pdp__thumb.is-active {
    border-color: var(--color-foreground);
  }

  .pdp__media-main {
    position: relative;
    flex: 1;
    aspect-ratio: 4 / 5;
    background: var(--color-background-secondary);
    border-radius: 4px;
    overflow: hidden;
  }

  .pdp__media-item {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 1;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .pdp__media-item.is-active {
    opacity: 1;
    z-index: 2;
    pointer-events: auto;
  }

  .pdp__media-item.is-color-hidden,
  .pdp__thumb.is-color-hidden {
    display: none;
  }

  .pdp__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (hover: hover) {
    .pdp__media-main {
      cursor: zoom-in;
    }

    .pdp__media-item img {
      transition: transform 0.35s ease;
    }

    .pdp__media-main.is-zooming .pdp__media-item.is-active img {
      transform: scale(1.6);
    }
  }

  .pdp__badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 5;
    background: var(--color-background);
    color: var(--color-foreground);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 5px 9px;
    border-radius: 2px;
    pointer-events: none;
  }

  .pdp__badge--sale {
    background: var(--color-accent);
    color: var(--color-background);
  }

  .pdp__info form {
    display: flex;
    flex-direction: column;
    padding-top: 6px;
  }

  .pdp__eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .pdp__eyebrow-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent-secondary);
  }

  .pdp__title-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-top: 12px;
  }

  .pdp__title {
    margin: 0;
    font-size: 46px;
    line-height: 1;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
    flex: 1;
  }

  .wish {
    display: inline-flex;
    padding-top: 8px;
  }

  .wish__btn {
    border: none;
    background: none;
    padding: 6px;
    color: var(--color-muted);
    cursor: pointer;
    transition: color 0.18s ease, transform 0.18s ease;
  }

  .wish__btn:hover {
    color: var(--color-accent-secondary);
  }

  .wish__btn.is-active {
    color: var(--color-accent-secondary);
  }

  .wish__btn.is-active svg path {
    fill: currentColor;
  }

  .wish__btn:active {
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .wish__btn {
      transition: none;
    }
  }

  .pdp__title-accent {
    color: var(--color-accent);
  }

  .pdp__price-area {
    margin-top: 16px;
  }

  .pdp__price {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .pdp__compare {
    font-size: 16px;
    color: var(--color-muted);
  }

  .pdp__amount {
    font-size: 22px;
    font-weight: 600;
  }

  .pdp__save {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-accent);
  }

  .pdp__unit-price,
  .pdp__tax-note,
  .pdp__sku {
    font-size: 13px;
    color: var(--color-muted);
    margin-top: 4px;
  }

  .pdp__description {
    margin-top: 20px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-muted);
    max-width: 440px;
  }

  .pdp__sizechart-btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 12px;
    margin-top: 24px;
    padding: 0;
    border: none;
    background: none;
    font-family: var(--font-primary--family);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-foreground);
    cursor: pointer;
    transition: color 0.18s ease;
  }

  .pdp__sizechart-btn:hover {
    color: var(--color-accent-secondary);
  }

  .sizechart {
    border: 1px solid var(--color-line);
    border-radius: 4px;
    background: var(--color-background);
    color: var(--color-foreground);
    padding: 28px;
    width: min(480px, calc(100vw - 32px));
    margin: auto;
  }

  .sizechart::backdrop {
    background: rgba(20, 20, 15, 0.4);
  }

  .sizechart__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 6px;
  }

  .sizechart__title {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .sizechart__close {
    border: none;
    background: none;
    font-size: 22px;
    line-height: 1;
    color: var(--color-muted);
    cursor: pointer;
    padding: 4px;
  }

  .sizechart__close:hover {
    color: var(--color-foreground);
  }

  .sizechart__note {
    margin: 0 0 18px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .sizechart__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  .sizechart__table thead th {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    text-align: left;
    padding: 0 10px 10px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .sizechart__table td,
  .sizechart__table tbody th {
    padding: 12px 10px 12px 0;
    border-bottom: 1px solid var(--color-line);
    text-align: left;
    font-weight: 400;
  }

  .sizechart__row {
    cursor: pointer;
  }

  .sizechart__row:hover:not(.is-soldout) {
    background: var(--color-background-secondary);
  }

  .sizechart__select {
    border: none;
    background: none;
    padding: 0;
    font-family: var(--font-primary--family);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-foreground);
    cursor: pointer;
    display: flex;
    gap: 8px;
    align-items: baseline;
  }

  .sizechart__row.is-soldout {
    cursor: not-allowed;
  }

  .sizechart__row.is-soldout td,
  .sizechart__row.is-soldout .sizechart__select {
    color: var(--color-input-line);
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .sizechart__soldout-tag {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-accent-secondary);
  }

  .sizechart__hint {
    margin: 16px 0 0;
    font-size: 12px;
    color: var(--color-muted);
  }

  .pdp__option {
    border: none;
    padding: 0;
    margin: 22px 0 0;
  }

  .pdp__option-name {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
    padding: 0;
    margin-bottom: 10px;
    display: block;
  }

  .pdp__option-name [data-selected-value] {
    color: var(--color-foreground);
  }

  .pdp__option-values {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pdp__value input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .pdp__value-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 56px;
    padding: 12px 14px;
    border: 1px solid var(--color-input-line);
    border-radius: var(--style-border-radius-inputs);
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 0.18s ease, background 0.18s ease;
  }

  .pdp__value-pill:hover {
    border-color: var(--color-foreground);
  }

  .pdp__value input:checked + .pdp__value-pill {
    background: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  .pdp__value.is-soldout .pdp__value-pill {
    color: var(--color-input-line);
    text-decoration: line-through;
    cursor: not-allowed;
  }

  .pdp__value.is-soldout .pdp__value-pill:hover {
    border-color: var(--color-input-line);
  }

  .pdp__value.is-soldout .pdp__swatch-dot {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .pdp__value input:focus-visible + .pdp__value-pill,
  .pdp__value input:focus-visible + .pdp__swatch-dot {
    outline: 2px solid var(--color-accent-secondary);
    outline-offset: 2px;
  }

  .pdp__value--swatch {
    display: inline-flex;
  }

  .pdp__swatch-dot {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(var(--color-foreground-rgb), 0.2);
    background-size: cover;
    cursor: pointer;
  }

  .pdp__value input:checked + .pdp__swatch-dot {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 4px var(--color-foreground);
  }

  .pdp__variant-select {
    margin-top: 10px;
    padding: 12px;
    border: 1px solid var(--color-input-line);
    border-radius: var(--style-border-radius-inputs);
    font-family: var(--font-primary--family);
    font-size: 14px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .pdp__quantity {
    margin-top: 22px;
  }

  .pdp__qty {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--color-input-line);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .pdp__qty-btn {
    width: 44px;
    border: none;
    background: transparent;
    font-size: 17px;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .pdp__qty-btn:hover {
    background: var(--color-background-secondary);
  }

  .pdp__qty-input {
    width: 50px;
    border: none;
    text-align: center;
    font-family: var(--font-primary--family);
    font-size: 15px;
    background: transparent;
    color: var(--color-foreground);
    appearance: textfield;
    -moz-appearance: textfield;
    padding: 12px 0;
  }

  .pdp__qty-input::-webkit-outer-spin-button,
  .pdp__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
  }

  .pdp__buy {
    display: flex;
    flex-direction: column;
    margin-top: 20px;
  }

  .pdp__stock {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-muted);
    margin-bottom: 20px;
  }

  .pdp__stock-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .pdp__atc {
    width: 100%;
    padding: 18px 30px;
    border: none;
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-primary--family);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .pdp__atc:hover {
    background: var(--color-accent);
  }

  .pdp__atc[disabled] {
    background: var(--color-muted);
    cursor: not-allowed;
  }

  .pdp__buy shopify-accelerated-checkout,
  .pdp__buy .shopify-payment-button {
    margin-top: 10px;
  }

  .pdp__buy shopify-payment-terms {
    margin-top: 10px;
    font-size: 13px;
    color: var(--color-muted);
  }

  .pdp__pickup {
    display: flex;
    gap: 10px;
    align-items: baseline;
    font-size: 14px;
    color: var(--color-muted);
    margin-top: 18px;
  }

  .pdp__pickup:empty {
    display: none;
  }

  .pdp__pickup-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-muted);
    flex-shrink: 0;
  }

  .pdp__pickup-dot--yes {
    background: var(--color-accent);
  }

  .pdp__accordions {
    display: block;
    margin-top: 34px;
    border-top: 1px solid var(--color-line);
  }

  .pdp__accordion {
    border-bottom: 1px solid var(--color-line);
  }

  .pdp__accordion-title {
    padding: 17px 0;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pdp__accordion-title::-webkit-details-marker {
    display: none;
  }

  .pdp__accordion-chevron {
    color: var(--color-muted);
    flex: none;
    transition: transform 0.28s ease-out;
  }

  .pdp__accordion[open] .pdp__accordion-chevron {
    transform: rotate(180deg);
  }

  .pdp__accordion-body {
    overflow: hidden;
  }

  .pdp__accordion-text {
    margin: 0;
    padding: 0 0 18px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--color-muted);
    opacity: 0;
    transition: opacity 0.2s ease 0.08s;
  }

  .pdp__accordion[open] .pdp__accordion-text {
    opacity: 1;
  }

  html:not(.js) .pdp__accordion-text {
    opacity: 1;
  }

  .pdp__share {
    display: flex;
    gap: 18px;
    margin-top: 20px;
    font-size: 13px;
  }

  .pdp__share a,
  .pdp__copy-link {
    color: var(--color-muted);
  }

  .pdp__copy-link {
    border: none;
    background: none;
    padding: 0;
    font-family: var(--font-primary--family);
    font-size: 13px;
    cursor: pointer;
  }

  .pdp__share a:hover,
  .pdp__copy-link:hover {
    color: var(--color-accent-secondary);
  }

  .pdp__text-block {
    margin: 14px 0 0;
    font-size: 13px;
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .pdp__media-item,
    .pdp__media-item img,
    .pdp__thumb,
    .pdp__accordion-chevron,
    .pdp__accordion-text {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    .pdp {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 20px;
      padding-bottom: 56px;
    }

    .pdp__gallery {
      position: static;
      flex-direction: column-reverse;
    }

    .pdp__thumbs {
      flex-direction: row;
    }

    .pdp__title {
      font-size: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
