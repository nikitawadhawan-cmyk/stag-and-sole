<recently-viewed
  class="recently-viewed"
  data-limit="{{ section.settings.products_to_show }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-current="{{ product.handle }}"
  hidden
>
  <section class="wrap recently-viewed__in">
    <header class="recently-viewed__head">
      <h2 class="recently-viewed__title">{{ section.settings.heading }}</h2>
    </header>
    <div class="recently-viewed__grid" data-recent-grid></div>
  </section>
</recently-viewed>

{% javascript %}
  class RecentlyViewed extends HTMLElement {
    connectedCallback() {
      let handles = [];
      try {
        handles = JSON.parse(localStorage.getItem('stag:recently-viewed') || '[]');
      } catch (e) {
        return;
      }
      const current = this.dataset.current;
      handles = handles.filter((h) => h && h !== current).slice(0, parseInt(this.dataset.limit || '4', 10));
      if (!handles.length) return;
      this.build(handles);
    }

    async build(handles) {
      const currency = this.dataset.currency || 'USD';
      let format;
      try {
        format = new Intl.NumberFormat(document.documentElement.lang || undefined, {
          style: 'currency',
          currency: currency,
        });
      } catch (e) {
        format = { format: (n) => `${currency} ${n.toFixed(2)}` };
      }
      const grid = this.querySelector('[data-recent-grid]');
      const results = await Promise.all(
        handles.map((handle) =>
          fetch(`/products/${handle}.js`)
            .then((res) => (res.ok ? res.json() : null))
            .catch(() => null)
        )
      );
      const products = results.filter(Boolean);
      if (!products.length) return;
      for (const product of products) {
        const card = document.createElement('a');
        card.className = 'rv-card';
        card.href = product.url;
        const sep = String(product.featured_image).includes('?') ? '&' : '?';
        const img = product.featured_image
          ? `<img class="rv-card__img" src="${product.featured_image}${sep}width=600" srcset="${product.featured_image}${sep}width=300 300w, ${product.featured_image}${sep}width=600 600w" sizes="(max-width: 900px) 50vw, 25vw" loading="lazy" alt="">`
          : '';
        const compare =
          product.compare_at_price > product.price
            ? `<s class="rv-card__compare">${format.format(product.compare_at_price / 100)}</s>`
            : '';
        card.innerHTML = `
          <span class="rv-card__media">${img}</span>
          <span class="rv-card__title"></span>
          <span class="rv-card__price">${compare} ${format.format(product.price / 100)}</span>
        `;
        card.querySelector('.rv-card__title').textContent = product.title;
        grid.appendChild(card);
      }
      this.hidden = false;
    }
  }

  if (!customElements.get('recently-viewed')) {
    customElements.define('recently-viewed', RecentlyViewed);
  }
{% endjavascript %}

{% stylesheet %}
  .recently-viewed[hidden] {
    display: none;
  }

  .recently-viewed__in {
    padding-top: 56px;
    padding-bottom: 24px;
  }

  .recently-viewed__head {
    margin-bottom: 22px;
  }

  .recently-viewed__title {
    margin: 0;
    font-size: 26px;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .recently-viewed__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  .rv-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--color-foreground);
  }

  .rv-card__media {
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    background: var(--color-background-secondary);
  }

  .rv-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .rv-card:hover .rv-card__img {
    transform: scale(1.04);
  }

  .rv-card__title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .rv-card__price {
    font-size: 13px;
    color: var(--color-muted);
  }

  .rv-card__compare {
    margin-right: 6px;
  }

  @media (max-width: 900px) {
    .recently-viewed__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rv-card__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Recently viewed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Recently viewed"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
