{% if section.settings.source == 'collections' and section.settings.collections.size > 0 %}
  <section class="wrap section related-products" data-reveal>
    <scroll-row>
    <div class="section-head">
      <h2>{{ section.settings.heading }}</h2>
      <div class="scroll-arrows">
        <button type="button" class="scroll-arrows__btn" data-scroll-prev aria-label="{{ 'general.previous' | t }}">&larr;</button>
        <button type="button" class="scroll-arrows__btn" data-scroll-next aria-label="{{ 'general.next' | t }}">&rarr;</button>
      </div>
    </div>
    <div class="related-products__grid" data-scroll-track data-reveal-stagger>
      {% liquid
        # One product per collection, round-robin, skipping the current
        # product and anything already shown.
        assign used = '|' | append: product.handle | append: '|'
        assign slots = section.settings.products_to_show
        assign rendered = 0
      %}
      {% for pass in (1..3) %}
        {% for collection in section.settings.collections %}
          {% if rendered < slots %}
            {% for candidate in collection.products limit: 8 %}
              {% assign key = '|' | append: candidate.handle | append: '|' %}
              {% unless used contains key %}
                {% render 'product-card', product: candidate, show_type: true %}
                {% assign used = used | append: candidate.handle | append: '|' %}
                {% assign rendered = rendered | plus: 1 %}
                {% break %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
    </scroll-row>
  </section>
{% else %}
  <section class="wrap section related-products" data-reveal>
    <product-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
    >
      {% if recommendations.performed? and recommendations.products_count > 0 %}
        <scroll-row>
          <div class="section-head">
            <h2>{{ section.settings.heading }}</h2>
            <div class="scroll-arrows">
              <button type="button" class="scroll-arrows__btn" data-scroll-prev aria-label="{{ 'general.previous' | t }}">&larr;</button>
              <button type="button" class="scroll-arrows__btn" data-scroll-next aria-label="{{ 'general.next' | t }}">&rarr;</button>
            </div>
          </div>
          <div class="related-products__grid" data-scroll-track data-reveal-stagger>
            {% for product in recommendations.products %}
              {% render 'product-card', product: product, show_type: true %}
            {% endfor %}
          </div>
        </scroll-row>
      {% endif %}
    </product-recommendations>
  </section>
{% endif %}

{% stylesheet %}
  .related-products product-recommendations {
    display: block;
  }

  .related-products product-recommendations:empty {
    display: none;
  }

  .related-products__grid {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 14px;
    scrollbar-width: thin;
    scrollbar-color: var(--color-input-line) transparent;
  }

  .related-products__grid::-webkit-scrollbar {
    height: 6px;
  }

  .related-products__grid::-webkit-scrollbar-track {
    background: transparent;
  }

  .related-products__grid::-webkit-scrollbar-thumb {
    background: var(--color-input-line);
    border-radius: 3px;
  }

  .related-products__grid .product-card {
    flex: none;
    width: 300px;
    scroll-snap-align: start;
  }

  @media (max-width: 700px) {
    .related-products__grid {
      gap: 14px;
    }

    .related-products__grid .product-card {
      width: 240px;
    }
  }

  .scroll-arrows {
    display: flex;
    gap: 8px;
    align-self: center;
  }

  .scroll-arrows__btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-muted);
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }

  .scroll-arrows__btn:hover:not([disabled]) {
    border-color: var(--color-foreground);
    color: var(--color-foreground);
    background: var(--color-background-secondary);
  }

  .scroll-arrows__btn[disabled] {
    opacity: 0.3;
    cursor: default;
  }

  html:not(.js) .scroll-arrows,
  scroll-row.no-overflow .scroll-arrows {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products source",
      "options": [
        { "value": "automatic", "label": "Automatic recommendations" },
        { "value": "collections", "label": "One from each collection" }
      ],
      "default": "automatic"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "info": "Used with the collection source: shows one product from each, skipping the current product",
      "limit": 8
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ],
      "default": "related"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to show",
      "default": 4
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
