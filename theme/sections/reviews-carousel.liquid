<div data-reveal>
  <reviews-carousel class="revband">
    <h2 class="revband__title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank %}
        <span class="serif revband__accent">{{ section.settings.heading_accent }}</span>
      {%- endif -%}
    </h2>

    <div class="wrap revband__track" data-carousel-track>
      {% for block in section.blocks %}
        <div
          class="revband__card{% if forloop.index == 2 or section.blocks.size == 1 %} is-center{% endif %}{% if forloop.index > 3 %} is-offstage{% endif %}"
          data-carousel-card
          {{ block.shopify_attributes }}
        >
          <span class="revband__stars" role="img" aria-label="{{ 'sections.testimonials.stars_label' | t: rating: block.settings.rating }}">
            {%- for i in (1..5) -%}
              {%- if i <= block.settings.rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}
            {%- endfor -%}
          </span>
          <p class="revband__quote">{{ block.settings.quote }}</p>
          <div class="revband__who">
            {% if block.settings.author != blank %}
              <span class="revband__name">{{ block.settings.author }}</span>
            {% endif %}
            {% if block.settings.detail != blank %}
              <span class="revband__meta">{{ block.settings.detail }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

    {% if section.blocks.size > 3 %}
      <div class="revband__dots" data-carousel-dots>
        {% for block in section.blocks %}
          <button
            type="button"
            class="revband__dot{% if forloop.index == 2 %} is-active{% endif %}"
            data-carousel-dot="{{ forloop.index0 }}"
            aria-label="{{ 'sections.testimonials.review_number' | t: number: forloop.index }}"
          ></button>
        {% endfor %}
      </div>
      <button type="button" class="revband__arrow revband__arrow--prev" data-carousel-prev aria-label="{{ 'sections.testimonials.previous' | t }}">&larr;</button>
      <button type="button" class="revband__arrow revband__arrow--next" data-carousel-next aria-label="{{ 'sections.testimonials.next' | t }}">&rarr;</button>
    {% endif %}
  </reviews-carousel>
</div>

{% stylesheet %}
  .revband {
    display: block;
    position: relative;
    background: var(--color-background-secondary);
    padding: 76px 0 64px;
    margin-top: 76px;
  }

  .revband__title {
    margin: 0 0 40px;
    text-align: center;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .revband__accent {
    color: var(--color-accent);
  }

  .revband__track {
    display: flex;
    gap: 18px;
    align-items: center;
    justify-content: center;
  }

  .revband__card {
    background: rgba(var(--color-background-rgb), 0.45);
    border-radius: 4px;
    padding: 24px;
    width: 300px;
    flex: none;
    color: var(--color-muted);
  }

  .revband__card.is-center {
    background: var(--color-background);
    padding: 32px 30px;
    width: 360px;
    color: var(--color-foreground);
    z-index: 2;
  }

  .revband__card.is-offstage {
    display: none;
  }

  .revband__stars {
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--color-accent-secondary);
  }

  .revband__quote {
    margin: 12px 0 16px;
    font-size: 14px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .revband__name {
    display: block;
    font-size: 13px;
    font-weight: 600;
  }

  .revband__meta {
    display: block;
    font-size: 12px;
    color: var(--color-muted);
  }

  .revband__dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 32px;
  }

  .revband__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: none;
    padding: 0;
    cursor: pointer;
    background: var(--color-muted);
    opacity: 0.35;
    transition: opacity 0.18s ease;
  }

  .revband__dot.is-active {
    background: var(--color-foreground);
    opacity: 1;
  }

  .revband__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--color-foreground);
    background: transparent;
    color: var(--color-foreground);
    font-size: 17px;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease, background 0.18s ease;
  }

  .revband:hover .revband__arrow,
  .revband__arrow:focus-visible {
    opacity: 1;
  }

  .revband__arrow:hover {
    background: var(--color-background);
  }

  .revband__arrow--prev {
    left: 36px;
  }

  .revband__arrow--next {
    right: 36px;
  }

  html:not(.js) .revband__arrow,
  html:not(.js) .revband__dots {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .revband__arrow,
    .revband__dot {
      transition: none;
    }
  }

  @media (max-width: 1024px) {
    .revband {
      padding: 56px 0 48px;
      margin-top: 56px;
    }

    .revband__card {
      display: none;
    }

    .revband__card.is-center {
      display: block;
      width: 100%;
      max-width: 420px;
    }

    .revband__arrow--prev {
      left: 12px;
    }

    .revband__arrow--next {
      right: 12px;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ReviewsCarousel extends HTMLElement {
    connectedCallback() {
      this.cards = [...this.querySelectorAll('[data-carousel-card]')];
      this.dots = [...this.querySelectorAll('[data-carousel-dot]')];
      if (this.cards.length < 4) return;
      this.center = 1;
      const prev = this.querySelector('[data-carousel-prev]');
      const next = this.querySelector('[data-carousel-next]');
      if (prev) prev.addEventListener('click', () => this.go(this.center - 1));
      if (next) next.addEventListener('click', () => this.go(this.center + 1));
      this.dots.forEach((dot) => {
        dot.addEventListener('click', () => this.go(parseInt(dot.dataset.carouselDot, 10)));
      });
      this.render();
    }

    go(index) {
      const n = this.cards.length;
      this.center = ((index % n) + n) % n;
      this.render();
    }

    render() {
      const n = this.cards.length;
      const visible = [(this.center - 1 + n) % n, this.center, (this.center + 1) % n];
      const track = this.querySelector('[data-carousel-track]');
      visible.forEach((cardIndex) => track.appendChild(this.cards[cardIndex]));
      this.cards.forEach((card, i) => {
        card.classList.toggle('is-offstage', !visible.includes(i));
        card.classList.toggle('is-center', i === this.center);
      });
      this.dots.forEach((dot, i) => dot.classList.toggle('is-active', i === this.center));
    }
  }

  customElements.define('reviews-carousel', ReviewsCarousel);
{% endjavascript %}

{% schema %}
{
  "name": "Reviews carousel",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn and"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent word",
      "info": "Shows in the accent font",
      "default": "reviewed."
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Wore these straight out of the box for a full day. No blisters, no break-in period."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "For example the city or product purchased"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews carousel",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
