<section class="wrap richtext" data-reveal>
  <div class="richtext__inner">
    {% if section.settings.eyebrow != blank %}
      <div class="eyebrow">{{ section.settings.eyebrow }}</div>
    {% endif %}
    <h2 class="richtext__title">
      {{ section.settings.heading }}
      {%- if section.settings.heading_accent != blank %}
        <span class="serif richtext__accent">{{ section.settings.heading_accent }}</span>
      {%- endif -%}
    </h2>
    {% if section.settings.text != blank %}
      <div class="richtext__body rte">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_link }}" class="btn btn--dark richtext__btn">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .richtext {
    padding-top: 76px;
  }

  .richtext__inner {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .richtext__title {
    margin: 0;
    font-size: 44px;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 600;
    text-wrap: balance;
  }

  .richtext__accent {
    color: var(--color-accent);
  }

  .richtext__body {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 560px;
  }

  .richtext__btn {
    margin-top: 6px;
  }

  @media (max-width: 700px) {
    .richtext {
      padding-top: 56px;
    }

    .richtext__title {
      font-size: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Talk about your brand"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Accent word",
      "info": "Shows in the accent font"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Share a short statement about what you stand behind — the promise a shopper should remember.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
