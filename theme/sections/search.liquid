{% liquid
  assign per_page = section.settings.results_per_page
%}

{% paginate search.results by per_page %}
  <section class="wrap search-page">
    <header class="search-page__head">
      <h1 class="search-page__title">
        {% if search.performed %}
          {{ 'search.title' | t }}
        {% else %}
          {{ 'search.heading' | t }}
        {% endif %}
      </h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          aria-label="{{ 'search.placeholder' | t }}"
          class="search-page__input"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="search-page__submit">{{ 'search.submit' | t }}</button>
      </form>
      {% if search.performed %}
        <p class="search-page__count">
          {% if search.results_count > 0 %}
            {{ 'search.results_for_html' | t: count: search.results_count, terms: search.terms }}
          {% endif %}
        </p>
      {% endif %}
    </header>

    {% if search.performed %}
      {% if search.filters.size > 0 and search.results_count > 0 %}
        <collection-filters class="collection-toolbar">
          <form method="get" action="{{ routes.search_url }}" data-filter-form>
            <input type="hidden" name="q" value="{{ search.terms | escape }}">
            <input type="hidden" name="options[prefix]" value="last">
            <div class="collection-toolbar__row">
              <div class="collection-toolbar__filters">
                {% for filter in search.filters %}
                  <details class="cfilter" data-filter-details>
                    <summary class="cfilter__summary">
                      {{ filter.label }}
                      {%- if filter.active_values.size > 0 -%}
                        <span class="cfilter__count">{{ filter.active_values.size }}</span>
                      {%- endif %}
                      <svg width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                        <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.4"/>
                      </svg>
                    </summary>
                    <div class="cfilter__panel">
                      {% case filter.type %}
                        {% when 'list', 'boolean' %}
                          <ul class="cfilter__list" role="list">
                            {% for value in filter.values %}
                              <li>
                                <label class="cfilter__option{% if value.count == 0 and value.active == false %} is-empty{% endif %}">
                                  <input
                                    type="checkbox"
                                    name="{{ value.param_name }}"
                                    value="{{ value.value }}"
                                    {% if value.active %}
                                      checked
                                    {% endif %}
                                    {% if value.count == 0 and value.active == false %}
                                      disabled
                                    {% endif %}
                                  >
                                  <span class="cfilter__box" aria-hidden="true"></span>
                                  <span>{{ value.label }}</span>
                                  <span class="cfilter__value-count">{{ value.count }}</span>
                                </label>
                              </li>
                            {% endfor %}
                          </ul>
                        {% when 'price_range' %}
                          {% liquid
                            assign max_placeholder = filter.range_max | money_without_currency | replace: ',', ''
                          %}
                          <div class="cfilter__price">
                            <label>
                              <span>{{ 'collections.from' | t }}</span>
                              <input
                                type="number"
                                name="{{ filter.min_value.param_name }}"
                                {% if filter.min_value.value %}
                                  value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                {% endif %}
                                min="0"
                                placeholder="0"
                              >
                            </label>
                            <span class="cfilter__price-dash" aria-hidden="true">&ndash;</span>
                            <label>
                              <span>{{ 'collections.to' | t }}</span>
                              <input
                                type="number"
                                name="{{ filter.max_value.param_name }}"
                                {% if filter.max_value.value %}
                                  value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                {% endif %}
                                min="0"
                                placeholder="{{ max_placeholder }}"
                              >
                            </label>
                          </div>
                      {% endcase %}
                      <noscript>
                        <button type="submit" class="cfilter__apply">{{ 'collections.apply' | t }}</button>
                      </noscript>
                    </div>
                  </details>
                {% endfor %}
              </div>

              {% if search.sort_options.size > 0 %}
                <label class="collection-toolbar__sort">
                  <span>{{ 'collections.sort_by' | t }}</span>
                  <select name="sort_by" data-sort-select>
                    {% for option in search.sort_options %}
                      <option
                        value="{{ option.value }}"
                        {% if option.value == search.sort_by %}
                          selected
                        {% endif %}
                      >
                        {{ option.name }}
                      </option>
                    {% endfor %}
                  </select>
                </label>
              {% endif %}
            </div>
          </form>
        </collection-filters>
      {% endif %}

      {% if search.results_count == 0 %}
        <div class="search-page__empty">
          <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark">{{ 'cart.empty_cta' | t }}</a>
        </div>
      {% else %}
        {% liquid
          assign product_results = search.results | where: 'object_type', 'product'
          assign other_count = search.results.size | minus: product_results.size
        %}

        {% if product_results.size > 0 %}
          <div class="collection-grid search-page__products">
            {% for item in product_results %}
              {% render 'product-card', product: item, show_type: true, show_swatches: true %}
            {% endfor %}
          </div>
        {% endif %}

        {% if other_count > 0 %}
          <div class="search-page__other">
            <h2 class="search-page__other-title">{{ 'search.pages_and_articles' | t }}</h2>
            <ul class="search-page__list" role="list">
              {% for item in search.results %}
                {% if item.object_type == 'article' or item.object_type == 'page' %}
                  <li class="search-result">
                    <span class="search-result__type">
                      {% if item.object_type == 'article' %}
                        {{ 'search.article' | t }}
                      {% else %}
                        {{ 'search.page' | t }}
                      {% endif %}
                    </span>
                    <a href="{{ item.url }}" class="search-result__title">{{ item.title }}</a>
                    {% liquid
                      assign excerpt = ''
                      if item.object_type == 'article'
                        assign excerpt = item.excerpt_or_content | strip_html | truncate: 160
                      elsif item.content
                        assign excerpt = item.content | strip_html | truncate: 160
                      endif
                    %}
                    {% if excerpt != blank %}
                      <p class="search-result__excerpt">{{ excerpt }}</p>
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>
        {% endif %}
      {% endif %}

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="{{ 'collections.pagination' | t }}">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}" class="pagination__arrow">&larr;</a>
          {% endif %}
          {% for part in paginate.parts %}
            {% if part.is_link %}
              <a href="{{ part.url }}" class="pagination__page">{{ part.title }}</a>
            {% elsif part.title == paginate.current_page %}
              <span class="pagination__page is-current" aria-current="page">{{ part.title }}</span>
            {% else %}
              <span class="pagination__gap">{{ part.title }}</span>
            {% endif %}
          {% endfor %}
          {% if paginate.next %}
            <a href="{{ paginate.next.url }}" class="pagination__arrow">&rarr;</a>
          {% endif %}
        </nav>
      {% endif %}
    {% endif %}
  </section>
{% endpaginate %}

{% stylesheet %}
  .search-page {
    padding-top: 40px;
    padding-bottom: 80px;
  }

  .search-page__head {
    max-width: 560px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .search-page__title {
    margin: 0 0 22px;
    font-size: 42px;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .search-page__form {
    display: flex;
    gap: 10px;
  }

  .search-page__input {
    flex: 1;
    min-width: 0;
    border: 1px solid var(--color-input-line);
    background: var(--color-background);
    border-radius: var(--style-border-radius-inputs);
    padding: 16px 18px;
    font-family: var(--font-primary--family);
    font-size: 15px;
    color: var(--color-foreground);
    outline: none;
  }

  .search-page__input:focus {
    border-color: var(--color-accent-secondary);
  }

  .search-page__submit {
    padding: 16px 26px;
    border: none;
    border-radius: var(--style-border-radius-inputs);
    background: var(--color-foreground);
    color: var(--color-background);
    font-family: var(--font-primary--family);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.18s ease;
  }

  .search-page__submit:hover {
    background: var(--color-accent);
  }

  .search-page__count {
    margin: 16px 0 0;
    font-size: 14px;
    color: var(--color-muted);
  }

  .search-page__empty {
    padding: 60px 0 80px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .search-page__empty p {
    margin: 0;
    font-size: 16px;
    color: var(--color-muted);
  }

  .search-page__other {
    margin-top: 56px;
  }

  .search-page__other-title {
    margin: 0 0 8px;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .search-page__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .search-result {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .search-result__type {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  .search-result__title {
    font-size: 16px;
    font-weight: 600;
  }

  .search-result__excerpt {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-muted);
    max-width: 640px;
  }

  @media (max-width: 700px) {
    .search-page__title {
      font-size: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Search",
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Results per page",
      "default": 12
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
