<section class="wrap section">
  <div class="reviews-head">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.subheading != blank %}
      <span class="sub">{{ section.settings.subheading }}</span>
    {% endif %}
  </div>

  <div class="reviews">
    {% for block in section.blocks %}
      <div class="review" {{ block.shopify_attributes }}>
        <span class="review__stars" role="img" aria-label="{{ 'sections.testimonials.stars_label' | t: rating: block.settings.rating }}">
          {%- for i in (1..5) -%}
            {%- if i <= block.settings.rating -%}&#9733;{%- else -%}&#9734;{%- endif -%}
          {%- endfor -%}
        </span>
        <p class="review__quote">{{ block.settings.quote }}</p>
        <div class="review__who">
          {% if block.settings.author != blank %}
            <span class="review__name">{{ block.settings.author }}</span>
          {% endif %}
          {% if block.settings.detail != blank %}
            <span class="review__meta">{{ block.settings.detail }}</span>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .reviews-head {
    display: flex;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 26px;
  }

  .reviews-head h2 {
    margin: 0;
    font-size: 34px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .reviews-head .sub {
    font-size: 14px;
    color: var(--color-muted);
  }

  .reviews {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .review {
    background: var(--color-background-secondary);
    border-radius: 4px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .review__stars {
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--color-accent-secondary);
  }

  .review__quote {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .review__who {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .review__name {
    font-size: 13px;
    font-weight: 600;
  }

  .review__meta {
    font-size: 12px;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .reviews {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 700px) {
    .reviews-head h2 {
      font-size: 27px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What customers say"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Wore these straight out of the box for a full day. No blisters, no break-in period."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "For example the city or product purchased"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
