<section class="usp">
  <div class="wrap usp__in usp__in--{{ section.blocks.size }}">
    {% for block in section.blocks %}
      <div class="usp__item" {{ block.shopify_attributes }}>
        <span class="usp__title">{{ block.settings.heading }}</span>
        {% if block.settings.text != blank %}
          <span class="usp__sub">{{ block.settings.text }}</span>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .usp {
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    margin-top: 16px;
  }

  .usp__in {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .usp__in--3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .usp__in--2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .usp__item {
    padding: 26px 24px 26px 0;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .usp__item:last-child {
    padding-right: 0;
  }

  .usp__title {
    font-size: 14px;
    font-weight: 600;
  }

  .usp__sub {
    font-size: 13px;
    color: var(--color-muted);
  }

  @media (max-width: 1024px) {
    .usp__in {
      grid-template-columns: repeat(2, 1fr);
    }

    .usp__item {
      padding: 20px 16px 20px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Value propositions",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Value proposition",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free delivery over $50"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "3–5 days, tracked"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Value propositions",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "heading": "30-day returns", "text": "Wear them home first" } },
        { "type": "item", "settings": { "heading": "Free size exchange", "text": "One swap per order" } },
        { "type": "item", "settings": { "heading": "6-month sole warranty", "text": "Resoled or replaced" } }
      ]
    }
  ]
}
{% endschema %}
