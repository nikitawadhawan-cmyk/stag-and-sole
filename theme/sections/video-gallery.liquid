<section class="wrap section" data-reveal>
  <div class="section-head">
    <div class="section-head__stack">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <span class="sub">{{ section.settings.subheading }}</span>
      {% endif %}
    </div>
    {% if section.settings.link_label != blank and section.settings.link != blank %}
      <a href="{{ section.settings.link }}" class="more">{{ section.settings.link_label }} &rarr;</a>
    {% endif %}
  </div>

  <auto-scroller class="autoscroll">
    <div class="reels" data-autoscroll-track>
    {% for block in section.blocks %}
      {% liquid
        assign reel_url = block.settings.video_link
        if reel_url == blank and block.settings.product != blank
          assign reel_url = block.settings.product.url
        endif
      %}
      <a
        {% if reel_url != blank %}
          href="{{ reel_url }}"
        {% endif %}
        class="reel"
        {{ block.shopify_attributes }}
      >
        <div class="reel__media">
          {% if block.settings.image %}
            {%- liquid
              assign focal_style = nil
              if block.settings.image.presentation.focal_point
                assign focal_style = 'object-position: ' | append: block.settings.image.presentation.focal_point
              endif
            -%}
            {{
              block.settings.image
              | image_url: width: 800
              | image_tag: class: 'reel__img', widths: '400, 600, 800', sizes: '(max-width: 700px) 50vw, 25vw', loading: 'lazy', alt: block.settings.image.alt,
                style: focal_style
            }}
          {% else %}
            {% assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 %}
            {% assign placeholder_file = 'placeholder-reel-' | append: placeholder_index | append: '.jpg' %}
            <img
              src="{{ placeholder_file | asset_img_url: '480x' }}"
              srcset="{{ placeholder_file | asset_img_url: '360x' }} 360w, {{ placeholder_file | asset_img_url: '480x' }} 480w, {{ placeholder_file | asset_img_url: '720x' }} 720w"
              sizes="(max-width: 700px) 50vw, 25vw"
              class="reel__img"
              alt=""
              width="600"
              height="1067"
              loading="lazy"
            >
          {% endif %}
          <div class="reel__shade" aria-hidden="true"></div>
          <div class="reel__play" aria-hidden="true"><span></span></div>
          <div class="reel__caption">
            {% if block.settings.handle != blank %}
              <span class="reel__handle">{{ block.settings.handle }}</span>
            {% endif %}
            {% if block.settings.caption != blank %}
              <span class="reel__note">{{ block.settings.caption }}</span>
            {% endif %}
          </div>
        </div>
        {% if block.settings.product != blank or block.settings.detail != blank %}
          <div class="reel__meta">
            {% if block.settings.product != blank %}
              <span class="reel__product">{{ block.settings.product.title }}</span>
            {% endif %}
            {% if block.settings.detail != blank %}
              <span class="reel__views">{{ block.settings.detail }}</span>
            {% endif %}
          </div>
        {% endif %}
      </a>
    {% endfor %}
    </div>
  </auto-scroller>
</section>

{% stylesheet %}
  .reels {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .reel {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .reel__media {
    position: relative;
    aspect-ratio: 9 / 16;
    background: var(--color-background-secondary);
    border-radius: 4px;
    overflow: hidden;
  }

  .reel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .reel__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 55%, rgba(var(--color-foreground-rgb), 0.62));
    pointer-events: none;
  }

  .reel__play {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(var(--color-background-rgb), 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }

  .reel__play span {
    width: 0;
    height: 0;
    border-left: 11px solid var(--color-foreground);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    margin-left: 3px;
  }

  .reel__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    pointer-events: none;
  }

  .reel__handle {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-background);
  }

  .reel__note {
    font-size: 12px;
    color: var(--color-background);
    opacity: 0.78;
  }

  .reel__meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }

  .reel__product {
    font-size: 13px;
    font-weight: 600;
  }

  .reel__views {
    font-size: 12px;
    color: var(--color-muted);
  }

  @media (max-width: 1180px) {
    .reels {
      gap: 14px;
    }
  }

  @media (max-width: 1024px) {
    .reels {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .autoscroll.is-scrolling .reel {
    width: 270px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Video gallery",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Seen on feet"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Creators styling the collection — tap to play"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All videos"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Cover image",
          "info": "9:16 aspect ratio recommended"
        },
        {
          "type": "url",
          "id": "video_link",
          "label": "Video link"
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Creator handle"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Featured product"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail text",
          "info": "Shows beside the product name, for example view count"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video gallery",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
