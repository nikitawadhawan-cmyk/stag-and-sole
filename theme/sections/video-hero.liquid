<section class="video-hero video-hero--{{ section.settings.height }}" data-reveal>
  <div class="video-hero__media" aria-hidden="true">
    {% if section.settings.video != blank %}
      {{
        section.settings.video
        | video_tag:
          class: 'video-hero__video',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata'
      }}
    {% elsif section.settings.image %}
      {%- liquid
        assign focal_style = nil
        if section.settings.image.presentation.focal_point
          assign focal_style = 'object-position: ' | append: section.settings.image.presentation.focal_point
        endif
      -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag: class: 'video-hero__video', widths: '900, 1400, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: section.settings.image.alt, style: focal_style
      }}
    {% else %}
      {% render 'placeholder-image', name: section.settings.placeholder_image, class: 'video-hero__video', loading: 'eager', fetchpriority: 'high' %}
    {% endif %}
    <div class="video-hero__shade" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"></div>
  </div>

  <div class="wrap video-hero__content">
    {% if section.settings.eyebrow != blank %}
      <span class="video-hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="video-hero__title">
        {% liquid
          assign words = section.settings.heading | split: ' '
        %}
        {% if section.settings.accent_last_word and words.size > 1 %}
          {% for word in words %}
            {% if forloop.last %}
              <span class="serif video-hero__accent">{{ word }}</span>
            {% else %}
              {{ word }}
            {% endif %}
          {% endfor %}
        {% else %}
          {{ section.settings.heading }}
        {% endif %}
      </h2>
    {% endif %}
    {% if section.settings.text != blank %}
      <p class="video-hero__text">{{ section.settings.text }}</p>
    {% endif %}
    {% if section.settings.button_label != blank and section.settings.button_link != blank %}
      <a href="{{ section.settings.button_link }}" class="btn btn--light video-hero__btn">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .video-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    color: #ffffff;
  }

  .video-hero--medium {
    min-height: 62vh;
  }

  .video-hero--large {
    min-height: 84vh;
  }

  .video-hero__media {
    position: absolute;
    inset: 0;
  }

  .video-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .video-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 10, 8, 0.75), rgba(10, 10, 8, 0.15) 60%);
  }

  .video-hero__content {
    position: relative;
    width: 100%;
    padding-top: 80px;
    padding-bottom: 56px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .video-hero__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .video-hero__title {
    margin: 0;
    font-size: clamp(34px, 5.5vw, 64px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 600;
    max-width: 13em;
    text-wrap: balance;
  }

  .video-hero__accent {
    font-style: italic;
    font-weight: 400;
  }

  .video-hero__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    max-width: 460px;
    opacity: 0.9;
  }

  .video-hero__btn {
    margin-top: 8px;
  }

  .btn--light {
    background: #ffffff;
    color: #14140f;
  }

  .btn--light:hover {
    background: var(--color-accent-secondary);
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .video-hero__video {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /* Pause background video for reduced-motion users; browsers that block
     autoplay simply show the poster frame. */
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll('.video-hero__video').forEach(function (el) {
      if (el.tagName === 'VIDEO') el.pause();
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Video hero",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on a loop. Keep clips short for fast loading."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image",
      "info": "Shown when no video is selected."
    },
    {
      "type": "select",
      "id": "placeholder_image",
      "label": "Placeholder image",
      "options": [
        { "value": "street", "label": "Street" },
        { "value": "workshop", "label": "Workshop" },
        { "value": "stride", "label": "Street stride" },
        { "value": "boots", "label": "Boots studio" }
      ],
      "default": "street"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 60
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The new season"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the long walk"
    },
    {
      "type": "checkbox",
      "id": "accent_last_word",
      "label": "Show last word in accent font",
      "default": true
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Video hero"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
