<section class="wrap wishlist-page">
  <header class="wishlist-page__head">
    <h1 class="wishlist-page__title">{{ page.title | default: section.settings.heading }}</h1>
  </header>

  <wishlist-grid data-remove-label="{{ 'cart.remove' | t }}">
    <div class="wishlist-page__grid" data-wishlist-grid hidden></div>
    <div class="wishlist-page__empty" data-wishlist-empty>
      <p>{{ 'wishlist.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--dark">{{ 'cart.empty_cta' | t }}</a>
    </div>
  </wishlist-grid>

  <noscript>
    <p class="wishlist-page__noscript">{{ 'wishlist.requires_js' | t }}</p>
  </noscript>
</section>

{% stylesheet %}
  .wishlist-page {
    padding-top: 32px;
    padding-bottom: 80px;
  }

  .wishlist-page__head {
    margin-bottom: 28px;
  }

  .wishlist-page__title {
    margin: 0;
    font-size: 42px;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .wishlist-page__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    row-gap: 36px;
  }

  .wishlist-card {
    position: relative;
  }

  .wishlist-card__remove {
    align-self: flex-start;
    border: none;
    background: none;
    padding: 0;
    font-family: var(--font-primary--family);
    font-size: 12px;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .wishlist-card__remove:hover {
    color: var(--color-accent-secondary);
  }

  .wishlist-page__empty {
    padding: 90px 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }

  .wishlist-page__empty p {
    margin: 0;
    font-size: 17px;
    color: var(--color-muted);
  }

  .wishlist-page__noscript {
    font-size: 14px;
    color: var(--color-muted);
  }

  @media (max-width: 1180px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 900px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wishlist"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
