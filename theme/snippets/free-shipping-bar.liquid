{% doc %}
  Renders the free shipping progress banner. Hidden when disabled, when the
  threshold is 0, or when the cart is empty.
{% enddoc %}

{% liquid
  assign threshold = settings.free_shipping_threshold | times: 100
%}
{% if settings.show_free_shipping_bar and threshold > 0 and cart.item_count > 0 %}
  {% liquid
    assign remaining = threshold | minus: cart.total_price
    assign progress = cart.total_price | times: 100 | divided_by: threshold
    if progress > 100
      assign progress = 100
    endif
  %}
  <div class="offers" role="status">
    <div class="offers__banner">
      <span class="offers__icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none">
          <path d="M2.5 6.5h10v8h-10zM12.5 9h3l2 2.5v3h-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="6" cy="16" r="1.6" stroke="currentColor" stroke-width="1.4"/>
          <circle cx="14.5" cy="16" r="1.6" stroke="currentColor" stroke-width="1.4"/>
        </svg>
      </span>
      <span class="offers__banner-text">
        {%- if remaining > 0 -%}
          {%- assign remaining_money = remaining | money -%}
          {{ 'cart.free_shipping_away_html' | t: amount: remaining_money }}
        {%- else -%}
          {{ 'cart.free_shipping_unlocked' | t }}
        {%- endif -%}
      </span>
    </div>
    <div class="offers__panel">
      <div class="shipbar__track" aria-hidden="true">
        <div class="shipbar__fill{% if remaining <= 0 %} shipbar__fill--done{% endif %}" style="width: {{ progress }}%"></div>
      </div>
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .offers {
    border-radius: 10px;
    overflow: hidden;
    background: var(--color-accent);
    color: var(--color-background);
  }

  .offers__banner {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 16px 4px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .offers__icon {
    flex: none;
    display: inline-flex;
  }

  .offers__banner-text {
    flex: 1;
    min-width: 0;
  }

  .offers__banner-text strong {
    font-weight: 700;
  }

  .offers__panel {
    padding: 8px 16px 14px;
  }

  .shipbar__track {
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: rgba(var(--color-background-rgb), 0.25);
  }

  .shipbar__fill {
    height: 100%;
    border-radius: 2px;
    background: var(--color-background);
    transition: width 0.4s ease;
    max-width: 100%;
  }

  .shipbar__fill--done {
    background: var(--color-accent-secondary);
  }

  @media (prefers-reduced-motion: reduce) {
    .shipbar__fill {
      transition: none;
    }
  }
{% endstylesheet %}
