{% doc %}
  Renders the social media icon links set in theme settings. Networks
  without a link stay hidden.
{% enddoc %}

{% liquid
  assign has_social = false
  if settings.social_instagram_link != blank or settings.social_facebook_link != blank or settings.social_youtube_link != blank or settings.social_pinterest_link != blank or settings.social_tiktok_link != blank or settings.social_x_link != blank
    assign has_social = true
  endif
%}

{% if has_social %}
  <ul class="social" role="list">
    {% if settings.social_instagram_link != blank %}
      <li>
        <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">
          <span class="visually-hidden">Instagram</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="1.7"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/></svg>
        </a>
      </li>
    {% endif %}
    {% if settings.social_facebook_link != blank %}
      <li>
        <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">
          <span class="visually-hidden">Facebook</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0-1.6 19.9v-7h-2.5V12h2.5V9.8c0-2.5 1.5-3.9 3.7-3.9 1.1 0 2.2.2 2.2.2v2.4h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 12 2z"/></svg>
        </a>
      </li>
    {% endif %}
    {% if settings.social_youtube_link != blank %}
      <li>
        <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">
          <span class="visually-hidden">YouTube</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26.5 26.5 0 0 0 2 12c0 1.6.1 3.2.4 4.8a2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8c.3-1.6.4-3.2.4-4.8s-.1-3.2-.4-4.8zM10 15.2V8.8L15.5 12 10 15.2z"/></svg>
        </a>
      </li>
    {% endif %}
    {% if settings.social_pinterest_link != blank %}
      <li>
        <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">
          <span class="visually-hidden">Pinterest</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.7 19.3c-.1-.8-.2-2 0-2.9l1.2-5s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.6 1.3 1.4 0 .9-.6 2.2-.9 3.4-.2 1 .5 1.8 1.5 1.8 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.7-4.1-4.2-4.1a4.4 4.4 0 0 0-4.6 4.4c0 .9.3 1.8.8 2.3l-.3 1c-.1.4-.3.5-.6.3-1.2-.6-2-2.3-2-3.7 0-3 2.2-5.8 6.4-5.8 3.4 0 6 2.4 6 5.6 0 3.4-2.1 6.1-5 6.1-1 0-1.9-.5-2.2-1.1l-.6 2.3c-.2.9-.8 1.9-1.2 2.6A10 10 0 1 0 12 2z"/></svg>
        </a>
      </li>
    {% endif %}
    {% if settings.social_tiktok_link != blank %}
      <li>
        <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">
          <span class="visually-hidden">TikTok</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.7 2h-3v13.3a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.4a6 6 0 0 0-.9-.1 6 6 0 1 0 6 6V8.7a7.5 7.5 0 0 0 4.2 1.3v-3a4.5 4.5 0 0 1-4.3-5z"/></svg>
        </a>
      </li>
    {% endif %}
    {% if settings.social_x_link != blank %}
      <li>
        <a href="{{ settings.social_x_link }}" target="_blank" rel="noopener">
          <span class="visually-hidden">X</span>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3.1l-6.8 7.8L22 21h-6.3l-4.9-6.4L5.2 21H2.1l7.3-8.3L2 3h6.4l4.4 5.9L17.8 3zm-1.1 16.2h1.7L7.5 4.7H5.7l11 14.5z"/></svg>
        </a>
      </li>
    {% endif %}
  </ul>
{% endif %}

{% stylesheet %}
  .social {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 18px;
    align-items: center;
  }

  .social a {
    display: flex;
    color: currentColor;
    opacity: 0.85;
  }

  .social a:hover {
    opacity: 1;
    color: var(--color-accent-secondary);
  }
{% endstylesheet %}
